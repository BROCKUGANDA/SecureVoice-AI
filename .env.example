# ── Database connection budget (src/lib/db-pool.ts) ──────────────────────────
# A process is never the only process: compose runs `app` plus six workers
# against one DATABASE_URL. Behind a session-mode pooler (Supabase's Supavisor is
# the production case) the CLIENT cap is set outside this repository and applies
# to the whole deployment, so a per-process pool sized by CPU count overruns it
# and every query in the offending process fails with EMAXCONNSESSION.
#
# Behind a shared pooler both default to 1+1, so the fleet's worst case is 14
# against Supavisor's default of 15. That is starvation-avoidance, NOT capacity.
# Raising these REQUIRES raising the pooler's own client quota at the same time,
# or switching the pooler to transaction mode — see
# docs/runbooks/db-pool-exhaustion.md. Ignored when the database is self-hosted.
# DB_POOL_MAX="1"
# DB_AUDIT_POOL_MAX="1"

# ── Regulatory / AML evidence delivery (src/lib/regulatory-export.ts) ────────
# Where a compiled evidence package is pushed. Unset = compile and download only,
# with no outbound call: an endpoint that is not configured must never become a
# guessed default that ships case files somewhere unintended.
# BANK_COMPLIANCE_WEBHOOK_URL=""    # the institution's compliance intake
# BANK_COMPLIANCE_TOKEN=""          # bearer token scoped to that institution
# BANK_FIU_WEBHOOK_URL=""           # FIU endpoint for FATF Rec. 20 STR packages
# FIU_ENDPOINT=""                   # read as a fallback for the above

# ── Demo queue (src/lib/demo-queue.ts) ───────────────────────────────────────
# The public demo's admission control: capacity, per-IP join rate, and how long a
# signed-in seat survives without a heartbeat.
# DEMO_SEAT_CAPACITY="10"
# DEMO_JOIN_PER_HOUR="1000"
# DEMO_JOIN_IP_PER_HOUR="30"
# DEMO_LEASE_TTL_SEC="180"

# ── Voice-plane reachability probe (src/components/HealthCheck.tsx) ──────────
# Overrides the banner's probe path. Unset = the in-repo default, which is the
# path Caddy actually routes; a hostname here must resolve to a plane that exists,
# or the banner reports an outage that is not happening.
# NEXT_PUBLIC_VOICE_HEALTH_URL="/realtime/voice-health"

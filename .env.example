# NARRATOR_VOICE=""                     # walkthrough narration voice id
# CAPTURE_BASE_URL=""                   # walkthrough capture target
# BASE_URL=""                           # evidence pack target
# LOAD_DATABASE_URL=""                  # load-test DB (default local fallback)
# SUPABASE_POOLER_REGION=""             # Northflank runtime pooler region
# SUPABASE_ALLOW_INSECURE_TLS=""        # explicit TLS-verify opt-out for
#                                       # scripts/supabase-setup.mjs; never set
#                                       # against a public host
# NORTHFLANK_API="https://api.northflank.com/v1"
# NORTHFLANK_PROJECT="securevoice-ai"
# NF_GIT_URL=""
# NF_GIT_ACCOUNT=""
# SEED_OPERATOR_USER_ID=""
# SEED_DEMO_USER_ID=""
# SEED_OPERATOR_EMAIL=""
# SEED_DEMO_EMAIL=""

# Abuse controls (src/lib/abuse/config.ts + bad-actor ladder) ---------------
# All optional; defaults live in the abuse config module. Per-org overrides use
# the ABUSE_ALLOWED_COUNTRIES__<ORG> / ABUSE_PLAN_TIER__<ORG> suffix form.
#
# ABUSE_BUSINESS_HOURS_START/END/TZ double as the PERMITTED CALLING WINDOW for
# routine-category calls (call_category=routine): calls are refused outside it,
# and the dial worker parks them until it opens. For an FCA-style 8am-8pm rule
# set START=8, END=20. Defaults: 6/22 Asia/Dubai.
# ABUSE_ALLOWED_COUNTRIES=""
# ABUSE_DENIED_COUNTRIES=""
# ABUSE_DENIED_PREFIXES=""
# ABUSE_TEST_NUMBERS=""
# ABUSE_BURST_WINDOW_SEC=""
# ABUSE_BURST_RATE_MAX=""
# ABUSE_NEW_PREFIX_WINDOW_SEC=""
# ABUSE_NEW_PREFIX_BURST=""
# ABUSE_AFTER_HOURS_WARN=""
# ABUSE_AFTER_HOURS_PAUSE=""
# ABUSE_BUSINESS_HOURS_START=""
# ABUSE_BUSINESS_HOURS_END=""
# ABUSE_BUSINESS_HOURS_TZ=""
# ABUSE_ATTEMPT_WINDOW_SEC=""
# ABUSE_MAX_ATTEMPTS_PER_ORG=""
# ABUSE_MAX_PREFIXES_PER_ORG=""
# ABUSE_MAX_TRACKED_ORGS=""
# ABUSE_PAUSE_TTL_SEC=""
# ABUSE_COOLDOWN_SEC=""
# ABUSE_ORG_CONCURRENCY_CAP=""
# ABUSE_GLOBAL_CONCURRENCY_CAP=""

# --- Twilio Media Streams voice pipeline ---
# FEATURE_TWILIO_MEDIA_STREAMS="false"
# VOICE_STREAM_HOST="0.0.0.0"
# VOICE_STREAM_PORT="8080"
# ABUSE_MAX_COOLDOWN_ENTRIES=""
# ABUSE_PLAN_TIER=""
# Bad-actor strike ladder (src/lib/abuse/bad-actor.ts)
# ABUSE_BAD_ACTOR_WINDOW_MS="3600000"
# ABUSE_BAD_ACTOR_THROTTLE_AT="3"
# ABUSE_BAD_ACTOR_BLOCK_AT="6"
# ABUSE_BAD_ACTOR_BASE_BLOCK_MS="3600000"
# ABUSE_BAD_ACTOR_MAX_BLOCK_MS="86400000"
# ABUSE_BAD_ACTOR_MAX_TRACKED="10000"
# ABUSE_SLOT_LEASE_MS="900000"

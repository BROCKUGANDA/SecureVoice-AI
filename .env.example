# --- Database ---
# In docker-compose the DATABASE_URL is built from these parts (see
# docker-compose.yml) â€” do NOT set a full DATABASE_URL here, it is ignored.
# REQUIRED for a public deployment: a strong POSTGRES_PASSWORD.
# NOTE: changing POSTGRES_PASSWORD after first boot does nothing â€” the
# password is baked into the Postgres role at volume creation.
POSTGRES_USER="securevoice"
POSTGRES_PASSWORD=""
POSTGRES_DB="securevoice"

# Seed the demo case history on first boot (idempotent). Set "false" for a
# clean production database.
SEED_DEMO="true"

# Full connection string â€” ONLY for running Prisma/your own tooling outside
# compose (e.g. against an external Postgres). Ignored by the compose stack.
# NOTE: Supabase's DIRECT host is AAAA-only (IPv6); use the IPv4 pooler:
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#     ?pgbouncer=true&sslmode=disable
DATABASE_URL=""

# --- ElevenLabs Agents Platform (Stage 2) ---
# The real conversational agent that orchrates the fraud-intervention call.
# Created via POST /v1/convai/agents. Browser sessions are minted server-side
# from this id only â€” /api/elevenlabs/signed-url rejects any other agent_id
# with 403 agent_not_allowed, which is how agent pinning is enforced.
ELEVENLABS_AGENT_ID=""

# Shared secret that the ElevenLabs agent must present on every webhook tool
# call (sent as the `x-agent-tool-secret` header). 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This is the ONLY credential standing between an untrusted caller and a
# card_freeze request, so it must never be exposed to a browser or logged.
AGENT_TOOL_SECRET=""

# Comma-separated allow-list of tool names this deployment will authorize.
# A valid secret for one tool does NOT authorize another â€” the tool name must
# also appear here (see src/lib/agent-tool-auth.ts). Keep this minimal:
#   AGENT_TOOL_ALLOWED="card_freeze,human_handoff,verify_transaction,switch_language"
AGENT_TOOL_ALLOWED="card_freeze,human_handoff,verify_transaction,switch_language"

# --- ElevenLabs Integration ---
# The team key â€” server-side ONLY. Never echoed to clients. Read once at boot,
# held in process memory, never logged.
#
# To get a key: app.elevenlabs.io â†’ Profile + API Key
# Rotation cadence: every 90 days. Old keys stay valid for 7d after rotation
# to allow zero-downtime cutover.
ELEVENLABS_API_KEY=""

# Vendor mode. When "true", all upstream calls are skipped and the existing
# z-ai-web-dev-sdk dev backend serves the request. This is the default for
# the public demo so we never burn quota. Flip to "false" (or remove) for
# the Stage 2 build to use the real ElevenLabs platform.
ELEVENLABS_DRY_RUN="true"

# ElevenLabs model overrides (only take effect when DRY_RUN != "true").
# TTS: eleven_multilingual_v2 (code default) or eleven_v3 (higher expressiveness).
# STT: scribe_v2 (code default, current generation) â€” pin scribe_v1 only if
# your account tier requires it.
ELEVENLABS_MODEL="eleven_v3"
ELEVENLABS_STT_MODEL="scribe_v2"

# Deepgram nova-2 â€” independent ASR fallback vendor (used when ElevenLabs STT
# is unconfigured or errors). Server-side only.
DEEPGRAM_API_KEY=""

# --- Voice routing (prod mode) ---
# Real ElevenLabs voice_ids, one per language, from your own voice library
# (app.elevenlabs.io â†’ Voices â†’ copy the Voice ID). Required when
# ELEVENLABS_DRY_RUN != "true": the /api/tts route accepts a language key
# (en|ar|hi|ur) and resolves it to the voice_id below. Cloned bank-approved
# voices should be registered here AND in the Voice table (consent metadata
# is enforced server-side for clones).
ELEVENLABS_VOICE_EN=""
ELEVENLABS_VOICE_AR=""
ELEVENLABS_VOICE_HI=""
ELEVENLABS_VOICE_UR=""
ELEVENLABS_VOICE_FR=""
ELEVENLABS_VOICE_SW=""

# --- Rate limits ---
# Per-caller budget for TTS / ASR / agent turns. Default 60/hour.
RATE_LIMIT_PER_HOUR="60"

# --- Feature flags ---
# Every runtime switch lives in src/lib/flags.ts. Values are strictly "true" or
# "false" â€” anything else (yes, 1, empty) throws at read time, because a typo'd
# value would otherwise read as "disabled" and look like a deliberate choice.
#
# Defaults put the safe path first: anything touching money, PII, or the audit
# chain is off unless you turn it on. Leave this block commented out to run the
# conservative defaults.
#
# FEATURE_REALTIME="false"           # signed push to the realtime service (needs
#                                    # REALTIME_INGEST_SECRET too; both or neither)
# FEATURE_CONSOLE_LIVE_FEED="false"  # console live feed over websocket instead of
#                                    # SSE; read by the browser via
#                                    # /api/console/features
# FEATURE_PII_REDACTION="true"       # redact PII in logs, audit rows, webhooks.
#                                    # Off = writing customer transcripts in the
#                                    # clear. Debug-only.
# FEATURE_ELEVEN_LABS_LIVE="false"   # real neural voice. ELEVENLABS_DRY_RUN still
#                                    # wins if set, since the provider client reads
#                                    # it directly.

# --- Webhook signing (production) ---
# Server-side secret used BOTH ways:
#  1. Signing outbound post-call webhooks â€” the customer verifies
#     SV-Signature: t=<ts>,v1=<sha256(t.body, WEBHOOK_SECRET)>.
#  2. Verifying INBOUND risk signals on POST /api/interventions â€” the bank's
#     fraud engine signs with the same scheme. Rotate by setting a new value
#     + alerting all producers.
WEBHOOK_SECRET=""

# --- Clerk (authentication) ---
# The publishable key is INLINED at build time (NEXT_PUBLIC_*): it must be set
# in this file BEFORE `docker compose build`, or every request 500s.
# The secret key is read at runtime only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Session/BYOK secret ---
# 384-bit secret. Encrypts organization BYOK ElevenLabs keys at rest
# (src/lib/byok.ts) â€” rotating it invalidates stored BYOK keys (re-enter them).
# There is NO fallback: BYOK storage throws without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Twilio live telephony ---
# Places REAL fraud-intervention calls + SMS to enrolled customers
# (POST /api/enroll). Runtime auth prefers a dedicated API key (rotatable,
# revocable) over the master token. WITHOUT these vars the platform runs in
# audit-only mode â€” everything works, nothing is dialed.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# TRIAL ACCOUNTS: calls/SMS only succeed to numbers verified in the Twilio
# console (Phone Numbers â†’ Verified Caller IDs). Upgrade for unrestricted
# delivery. Find credentials: console.twilio.com â†’ Account Info / API Keys.

# --- Compliance flags ---
# All three are server-enforced and CANNOT be disabled by a route or client.
# Leaving them "true" is the safe default; they exist so that the policy is
# visible in code review, not because anyone should turn them off.
COMPLIANCE_OPENING_DISCLOSURE="true"
COMPLIANCE_NO_CREDENTIAL_REQUESTS="true"
COMPLIANCE_PII_REDACTION="true"

# --- Supabase (bank-side mirror DB) ---
# Optional: the bank-facing `interventions` mirror table (with a `language`
# column) lives in Supabase; the platform runtime DB is Prisma/PostgreSQL.
# Provision it with: node scripts/supabase-setup.mjs
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY="" # publishable/anon key â€” safe client-side
SUPABASE_DATABASE_URL="" # postgres connection string â€” SERVER-SIDE ONLY

# --- Groq (optional fast LLM reply layer) ---
# When set, the agent drafts replies via Groq (qwen/qwen3.8-27b default (llama-3.1 retired from Groq 2026-09),
# override with GROQ_MODEL) in the customer's language under voice guardrails
# (<= 50 words, no markdown/emojis, never break character). Intent routing +
# compliance guardrails stay deterministic. Unset â†’ scripted replies.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GEMINI_API_KEY="" # optional â€” Gemini fallback when GROQ_API_KEY is unset
GEMINI_MODEL="gemini-1.5-flash"

# --- Realtime push + reverse proxy -------------------------------------------
# The Command Center's live feed uses a websocket when this is wired up, and falls
# back to its SSE endpoint when it isn't â€” so the console works either way.

# HMAC key shared by the app and mini-services/realtime. Generate with:
#   openssl rand -base64 32
# Leave empty to disable the push path entirely: the realtime service refuses every
# connection and the console stays on SSE.
REALTIME_INGEST_SECRET=""

# Where the app sends signed ingest. Inside compose this is the service name
# (the compose default is already http://realtime:4000 â€” leave this UNSET so
# the default wins). NEVER localhost/127.0.0.1: in the app container that
# resolves to the app itself and silently kills the push path.
# REALTIME_URL="http://realtime:4000"

# Comma-separated browser origins the socket accepts. Empty = any (dev only).
REALTIME_ALLOWED_ORIGIN=""

# --- Caddy ---------------------------------------------------------------------
# Domain to issue a TLS certificate for; must resolve to this host. Blank =
# localhost (internal CA, no Let's Encrypt). Set both for a real deployment.
SITE_ADDRESS=""
ACME_EMAIL=""

# --- Edge layer ----------------------------------------------------------------
# Pre-auth request budget per client IP, applied in src/proxy.ts before routing.
# Deliberately separate from RATE_LIMIT_PER_HOUR, which governs expensive API calls.
EDGE_RATE_LIMIT_PER_HOUR="600"

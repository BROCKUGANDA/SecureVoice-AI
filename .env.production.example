# ============================================================================
# SecureVoice AI — PRODUCTION environment (TEMPLATE)
#
# Copy this to `.env.production` on the machine that deploys production, then
# fill it in. It is COMMITTED so the shape of a production environment is
# reviewable; `.env.production` itself is gitignored and holds real values.
#
# ⚠️  WHY THIS IS A `.example` AND NOT A LIVE `.env.production`
#
# Next loads `.env.production` AUTOMATICALLY on any build where
# NODE_ENV=production — including a local `bun run build` on a laptop. A
# production-shaped file with EMPTY values therefore silently overrides the dev
# values in `.env` and the local build goes out with no gateway, a
# `next-env/production` banner and no sandbox token. Measured: `next build`
# reported "Environments: .env.production, .env".
#
# Same trap in Docker: the container runs `NODE_ENV=production`, so
# `.env.production` inside the image wins over `/app/.env`. Compose mounts
# `.env` via `env_file`, which is process environment and beats files, but do
# not rely on that.
#
# ⚠️  THIS IS A TEMPLATE. Every value below is EMPTY on purpose.
#
# Inventing plausible ones would produce a file that looks configured and
# silently is not — the exact failure the env split exists to prevent.
#
# TO CONFIGURE PRODUCTION:
#   1. Paddle > Developer tools > Authentication  — create a LIVE API key
#      (prefixed pdl_live_). Set it below.
#   2. Paddle > Developer tools > Notifications    — copy the signing secret of
#      the PRODUCTION notification destination (not the sandbox one).
#   3. Paddle > Developer tools > Authentication  — create a LIVE client-side
#      token (prefixed live_).
#   4. Set NEXT_PUBLIC_SITE_URL to the public origin.
#   5. Set PADDLE_ALLOW_LIVE_KEYS to 1 — explicitly, deliberately. The adapter
#      refuses a live key without it, which is the guard against a live key
#      reaching a build that meant to test.
#
# The sandbox values live in `.env` and are NEVER copied here by hand: the ids
# differ, the secrets differ, and a sandbox id in production is a checkout that
# charges nothing and grants nothing.
# ============================================================================

# ── Billing: Paddle LIVE ────────────────────────────────────────────────────
PAYMENT_PROVIDER="paddle"

# Live key, pdl_live_ prefixed. The adapter refuses this until the var below is
# explicitly "1".
PADDLE_API_KEY=""
PADDLE_ALLOW_LIVE_KEYS=""

# Production notification signing secret (ntfs...).
PADDLE_WEBHOOK_SECRET=""

# Live price ids. Regenerate the catalog against the live account before
# filling these in — sandbox ids do not exist in production.
PADDLE_PRICES='{"usd_9900_month":"","usd_99000_year":"","usd_49900_month":"","usd_499000_year":"","usd_200000_month":"","usd_2000000_year":""}'

# ── Client side (inlined into the browser bundle) ───────────────────────────
NEXT_PUBLIC_PADDLE_ENVIRONMENT="production"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""

# ── Public origin ───────────────────────────────────────────────────────────
# Must be the real, approved domain. On sandbox, localhost is fine; on live it
# must be a domain Paddle recognises or checkout fails.
NEXT_PUBLIC_SITE_URL="https://securevoiceai.me"

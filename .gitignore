# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real keys stay local, only the template ships
.env*
!.env.example

# databases — runtime data (audit chains contain caller history), never tracked
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# vercel
.vercel

# typescript / build artifacts
*.tsbuildinfo
next-env.d.ts

# prisma — ORM v7 generates the client into src/ as TypeScript source.
# It is a build artifact (`bunx prisma generate`), never tracked.
/src/generated/

# logs & pids
*.log
*.pid

# package-manager lockfiles — bun.lock is the lockfile of record
package-lock.json

# ---------------------------------------------------------------------------
# Internal development tooling & agent artifacts — not part of the app,
# not for judges. Nothing below this line should ever be tracked.
# ---------------------------------------------------------------------------
.zscripts/
worklog.md
tool-results/
download/
scripts/tts-test/
.claude
.agents
.cursor
skills-lock.json
.z-ai-config
/skills/
local-*
prompt
# Bare `test` used to ignore ANY directory named test at any depth — it silently
# swallowed mini-services/realtime/test/ (48 tests guarding the websocket service).
# Scoped to the repo root so real test suites stay tracked.
/test

# --- submission hygiene: local scratch, never for judges ---
.mimosa/
docs/canvas-verify/
docs/canvas-verify-sub/
docs/canvas-build/geometry.json
docs/canvas-build/draw-list.json
docs/canvas-build/BRIEF.md
docs/canvas-build/probe_pdf.py
docs/canvas-build/__pycache__/
docs/canvas-build/template-pages/
docs/canvas-build/submission-pages/
docs/walkthrough/*.mp4
# superseded / broken earlier canvas + the stale 1-of-17 evidence run
docs/IDEA-CANVAS-FILLED.pdf
docs/canvas-with-text.pdf
docs/canvas-plan.json
docs/evidence/evidence-2026-09-10.json
# local Chromium profile for the walkthrough capture: cookies + Login Data, never push
scripts/walkthrough/out/
docs/walkthrough/poster.png
# superseded canvas approach (hardcoded coords) and an unused Supabase script;
# the live DB is Postgres via Prisma
scripts/draw-canvas-diagrams.py
scripts/probe-canvas.py
scripts/supabase-setup.mjs

# Coverage output. The pre-existing "/coverage" rule does NOT match this
# directory: a leading slash anchors the pattern, so "/coverage" only ever
# matched "coverage/", never ".coverage/" -- which is where lcov actually
# lands. That gap is how 73 lcov.info files reached a commit.
.coverage/

# Scratch output from ad-hoc probes (see .covprobe2/).
.covprobe2/

# Prisma/Postgres scratch scripts. One-off data patches (e.g. backfill.mjs,
# which linked UserProfile rows to Better Auth user rows before migration 6
# deleted them) are run by hand against a database, not shipped.
backfill.mjs

# ── Local tool state, 2026-10 ────────────────────────────────────────────────
# Generated code-graph / coverage / agent state. None of it is source, all of
# it is large, and all of it differs per machine, so a commit of any of it is
# noise a reviewer has to skip past. Listed explicitly because the existing
# rules above use anchored or partial paths that do not cover these.
.gitnexus/
.mimosa/
.zscripts/
.agents/
.claude/
.cursor/
.vscode/
.idea/
tool-results/
*.tsbuildinfo

# Local transcripts and dumps from debugging sessions.
*.tsbuildinfo.bak
dev.log
server.log
build.log
tsc.log
test-run.log
analyzer_out.txt
UsersHPtmpuserpath.txt
_*.txt
--full-page

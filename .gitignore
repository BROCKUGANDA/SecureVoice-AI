# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real keys stay local, only the template ships
.env*
!.env.example

# databases — runtime data (audit chains contain caller history), never tracked
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# vercel
.vercel

# typescript / build artifacts
*.tsbuildinfo
next-env.d.ts

# logs & pids
*.log
*.pid

# package-manager lockfiles — bun.lock is the lockfile of record
package-lock.json

# ---------------------------------------------------------------------------
# Internal development tooling & agent artifacts — not part of the app,
# not for judges. Nothing below this line should ever be tracked.
# ---------------------------------------------------------------------------
.zscripts/
worklog.md
tool-results/
download/
scripts/tts-test/
.claude
.z-ai-config
/skills/
local-*
prompt
test

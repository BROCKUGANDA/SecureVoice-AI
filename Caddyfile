# ---------------------------------------------------------------------------
# SecureVoice AI — production reverse proxy (TLS + Let's Encrypt)
#
#   docker compose up --build        → https://<your domain>
#
# This is the ONLY service that publishes a port. `app` and `realtime` listen on
# the compose network alone, so the origin is unreachable from the internet and
# the trust model in src/proxy.ts holds: it believes X-Forwarded-For only when
# this proxy identified itself on the connection.
#
# TOPOLOGY
#   /realtime/*     → realtime:4000   websocket + presence fan-out
#   /healthz        → answered here    so uptime probes cost nothing
#   everything else → app:3000        Next.js standalone
#   app not serving → maintenance page answered here — see (maintenance_page):
#                     `app` cannot render its own error when `app` is the thing
#                     that is down, so the edge has to.
#
# Caddy 2 gotchas this file is deliberately written around. Every one of these
# was hit and fixed during this build — do not "simplify" them away:
#
#   1. Site addresses are LITERAL — never an env var. A `{$VAR:default}` site
#      address collides fatally with a literal block for the same host
#      ("ambiguous site definition: securevoiceai.me", measured with `caddy
#      validate` against caddy:2-alpine, 2026-10-12), and before that it forced
#      the production box into a hand-diverged copy of this whole file. The
#      list at the bottom is literal; host-local extra sites arrive through the
#      untracked `import sites.d/*.caddy` below it, which cannot collide.
#      Plaintext development still lives in a SEPARATE file (Caddyfile.dev),
#      deliberately NOT a compose service.
#   2. Snippets `(name) { … }` must be DEFINED BEFORE any block that `import`s
#      them, or Caddy fails with "File to import not found".
#   3. There is NO `log { redact { … } }` in Caddy 2. Redaction is
#      `log { format filter { … } }`, and inside `fields` each entry MUST be on
#      one line — the multi-line braced form is a parse error.
#   4. Redaction does not appear under `apps.http.logging`; look at the
#      top-level `logging` key.
#   5. Inside compose, a `reverse_proxy` target must be the SERVICE NAME
#      (`app:3000`), never `localhost:3000` — localhost inside the caddy
#      container is the caddy container itself.
#
# Verify with `caddy validate --config Caddyfile` before shipping. Never assume.
# ---------------------------------------------------------------------------
{
	# ACME contact address for expiry notices.
	email {$ACME_EMAIL:admin@example.com}
	# Admin API stays internal to the container; never exposed.
	admin off
}

# ---- snippets: define before use --------------------------------------------------

# Request headers shared by both upstreams.
#
# NOTE: `header_up` is a `reverse_proxy` subdirective — it CANNOT be imported from
# a snippet the way `header` can, because a snippet expands to sibling directives
# at the site level, not inside the proxy's own block. Mixing it in here fails to
# adapt with "unrecognized directive: header_up". So the proxy-specific settings
# live in each proxy snippet, and only site-level things are shared.
(forwarded_headers) {
	# The left-most X-Forwarded-For entry is the original client; this is what
	# src/proxy.ts turns into a rate-limit key.
	#
	# INTENTIONALLY OVERRIDES CADDY'S DEFAULT — do not delete as "redundant".
	# Caddy warns this is unnecessary because its default already sets the header,
	# but the default APPENDS to a client-supplied chain. A caller sending
	# `X-Forwarded-For: 1.2.3.4` would then reach the app as
	# `1.2.3.4, <real-ip>`, and src/proxy.ts reads the LEFT-MOST entry as the
	# client — so the caller picks its own rate-limit key and gets a fresh bucket
	# per request. Setting the header outright discards anything the client sent.
	# The origin is reachable only from this proxy, so no legitimate chain needs
	# preserving.
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up Host {host}

	# Tell the app's edge layer that this request genuinely arrived through us.
	# src/proxy.ts trusts X-Forwarded-For only when it sees this marker, so a forged
	# header on a direct-to-origin request cannot buy extra rate-limit budget.
	header_up X-SecureVoice-Proxy "1"

	# DO NOT add `header_up Connection {>Connection}` here. Measured, not guessed:
	# with that line the websocket upgrade dies with
	#   HTTP 400 {"code":3,"message":"Bad request"} from Engine.IO,
	# while removing only that line returns 101 Switching Protocols. Caddy already
	# handles hop-by-hop headers and the upgrade itself, and re-setting Connection
	# fights it. Verified with a bare proxy on :8445 (400) vs :8446 (101).
	#
	# Response buffering is handled per-handler with `flush_interval -1` instead,
	# which is what keeps SSE and streamed TTS chunks unbuffered.
}

(secure_defaults) {
	header {
		# The app already sets these in next.config.ts; repeating them here hardens a
		# response even if the app behind the proxy is swapped out.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This process is a reverse proxy, never a browser-reachable document.
		-Server
	}
	encode zstd gzip
}

# ---- maintenance page: the edge answers when the origin cannot --------------------
#
# WHY THIS IS HERE AND NOT IN REACT. src/app/error.tsx is a client boundary: it
# renders only when the origin returned a page and that page then threw. When
# `app` itself is the thing that is down — container stopped, crash loop, a
# deploy that never passed its healthcheck — there is no origin response to
# render against, and the visitor reads Caddy's bare error text. The answer has
# to come from the process that is still up, which is this one.
#
# WHY THE BODY IS A `respond` STRING AND NOT public/maintenance.html. Two
# reasons, each one ruling out the obvious alternative:
#
#   · `respond` is the only directive here that writes a body AND a status this
#     file picks. `file_server` is documented to preserve "the error's HTTP
#     status code when run in handle_errors" — that is the error's own 502, not
#     the 503 the contract below needs, and inside `handle_response` it has no
#     documented status to take at all.
#   · `public/` is baked into the APP image; this container mounts only
#     `./Caddyfile` and `./sites.d` (docker-compose.yml), so a file there is
#     unreadable during exactly the outage it exists to describe. A bind mount
#     would fix that and add a second artifact that can drift from the edge
#     serving it — and the edge is the thing that has to be right alone.
#
# The cost of `respond` is that its body is a template: Caddy scans it for `{…}`
# tokens before writing, substituting recognised ones (an empty value collapses
# to nothing) and leaving unrecognised ones in place. So a `<style>` block would
# run every CSS rule through that scanner. The document below therefore holds
# exactly one pair of braces — `{time.now.http}`, which Caddy's own global
# replacer fills, so the page states a time the edge actually knows instead of a
# token nobody substituted — and the rest avoids the scanner: inline `style=`
# attributes instead of a `<style>` block, SVG `<animate>` instead of
# `@keyframes`, no JavaScript, no font request. The trade is recorded rather
# than hidden: with no `<style>` block there is no
# `@media (prefers-reduced-motion)` either, so the two animations run for as
# long as the page is served. tests/surface/edge-maintenance.test.ts holds the
# one-brace rule, because a `<style>` block added later is an edit that
# validates cleanly and silently changes what the page renders.
#
# WHAT THE PAGE CLAIMS, and why the claim is narrow. This document can only
# appear when `app` failed to answer. Live fraud calls are carried by
# voice-stream-worker and dial-worker, and signed deliveries to banks drain from
# outbox-worker — three containers that keep running through an outage of the
# web tier. Saying "the platform is down" would be a false alarm to anyone with
# a call in progress, so the copy names what is down and what is not.
#
# SURFACES THAT DO NOT GET THE PAGE: see @machine_surface and @page_surface in
# the (site) snippet. Every directive below carries @page_surface instead of
# being written un-matched, for two reasons. `header` sits before `respond` in
# Caddy's directive order, so an un-matched `Content-Type text/html` would be
# stamped onto the plain answer those surfaces get; and inside handle_errors an
# excluded request has to fall through with nothing written, because that is the
# only way it keeps Caddy's own gateway error instead of this document.
#
# 503 + Retry-After, never 200. A `respond` with no status code does not inherit
# the error: in a plain route it answers 200, which tells an uptime probe the
# site is healthy and tells a crawler to index the maintenance page. Every
# `respond` in this snippet and in both hooks names its code, and the gate test
# asserts the status rather than trusting the copy.

(maintenance_page) {
	# 20 seconds, matching the page's own `<meta http-equiv='refresh'>`: the
	# header is for clients that honour it and the meta tag is for the browser
	# that does not. The two disagreeing is how a visitor ends up staring at a
	# page nothing reloads.
	header @page_surface Retry-After "20"

	# Never indexable, twice over — the header for a crawler that reads the
	# response, the meta tag for one that reads the document. A maintenance page
	# left in the index outranks the real page it replaced, and getting
	# re-crawled after the outage is measured in weeks.
	header @page_surface X-Robots-Tag "noindex, nofollow"

	# A cached 503 outlives the outage it described: the origin recovers, the
	# page keeps being served from a browser or an intermediary cache, and the
	# incident report says it never ended.
	header @page_surface Cache-Control "no-store, max-age=0"

	# respond infers text/plain for anything that is not JSON; a maintenance page
	# rendered as source is worse than no maintenance page at all.
	header @page_surface Content-Type "text/html; charset=utf-8"

	respond @page_surface "<!doctype html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<meta name='robots' content='noindex, nofollow'>
<meta http-equiv='refresh' content='20'>
<title>SecureVoice AI — under maintenance</title>
</head>
<body style='margin:0;background:#0b1120;color:#e2e8f0;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;line-height:1.6'>
<main style='max-width:38rem;margin:0 auto;padding:14vh 1.5rem 3rem'>
<p style='margin:0 0 .5rem;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:#7dd3fc'>SecureVoice AI</p>
<h1 style='margin:0 0 1rem;font-size:1.9rem;line-height:1.25;color:#f8fafc'>This service is under maintenance</h1>
<p style='margin:0 0 1.25rem;color:#cbd5e1'>The web console cannot be reached right now. This page comes from the edge of the deployment and not from the application, which is why it is still here when the application is not.</p>
<p style='margin:0 0 1.5rem;padding:.9rem 1rem;border-left:3px solid #34d399;background:#0f1a2b;color:#d1fae5'>Live fraud calls and bank integrations are unaffected. The call workers, the media stream and the outbox that signs deliveries to banks run as separate services and keep working while this screen is up.</p>
<svg width='100%' height='34' viewBox='0 0 300 34' preserveAspectRatio='none' role='img' aria-label='Retrying automatically'>
<rect x='0' y='4' width='300' height='8' rx='4' fill='#1e293b'/>
<rect x='0' y='4' width='96' height='8' rx='4' fill='#38bdf8'>
<animate attributeName='x' values='-96;300' dur='2s' repeatCount='indefinite'/>
</rect>
<circle cx='8' cy='26' r='4' fill='#34d399'>
<animate attributeName='opacity' values='1;0.25;1' dur='2s' repeatCount='indefinite'/>
</circle>
<text x='22' y='30' fill='#94a3b8' style='font-size:9px'>retrying</text>
</svg>
<p style='margin:1rem 0 0;font-size:.86rem;color:#94a3b8'>This page retries on its own every 20 seconds — there is nothing to click. Edge time: {time.now.http}.</p>
<p style='margin:1.5rem 0 0;font-size:.8rem;color:#64748b'>HTTP 503 Service Unavailable; retry after 20 seconds.</p>
</main>
</body>
</html>" 503
}

# ---- site body: shared by every hostname -----------------------------------------
#
# This is a SNIPPET, not a site block. It used to be `{$SITE_ADDRESS:localhost} {…}`,
# which meant exactly one hostname could ever be served. The site list at the
# bottom imports this instead, so adding a hostname is one line at the bottom and
# zero edits in here — which matters because the alternative is copy-pasting 110
# lines of routing and letting the two copies drift.
#
# Nothing inside may reference {$SITE_ADDRESS}: a snippet is expanded per site, and
# a value that only makes sense for one hostname would silently apply to all of
# them.

(site) {
	import secure_defaults

	# ---- outage page: which requests the maintenance document may answer --------
	#
	# The outage page is served to a PERSON. @machine_surface is every path on
	# this edge that a program reads rather than a person looks at, and
	# @page_surface is exactly the paths outside that list:
	#
	#   · /api/health and /api/readyz are the two paths uptime monitors poll (and
	#     the two src/proxy.ts gives its own rate-limit scope — see
	#     tests/surface/probe-budget.test.ts). /api/readyz is also how ADR-008's
	#     graceful drain signals "instance leaving rotation":
	#     scripts/server-preload.ts answers 503 there on SIGTERM while in-flight
	#     requests finish. Wrapping that in a maintenance page gives one signal
	#     two meanings, which is the same class of defect that test exists for —
	#     a 429 there made a healthy origin look unhealthy, and a page here would
	#     make a real outage look planned.
	#   · /realtime* is the console's websocket and the Twilio media stream. A
	#     failure there belongs to the CALL plane — the very thing this page
	#     promises is unaffected — so answering it with this document would be a
	#     lie with a 503 stapled to it, and an HTML body on an upgrade handshake
	#     is useless to the client anyway.
	#   · /v1/* is the bank's integration surface (docs/INTEGRATION-CONTRACT.md):
	#     a bank's client reads a status code and a signed JSON body, never
	#     markup.
	#   · /api/* is this application's own machine surface. Measured 2026-10-19:
	#     POST /api/tts/stream answered 503 with the document below, while the route
	#     had deliberately answered `{"error":…,"fallback":true}` with a Retry-After,
	#     and the browser parses that field to decide whether to fall back to the
	#     buffered voice clip. No person opens an /api path — its readers are this
	#     app's client and a bank's SDK — so wrapping a structured degradation in a
	#     site-outage page both loses the fallback signal and reports a voice problem
	#     as if the platform were down.
	#   · /healthz is answered by this file and cannot reach an origin error, but
	#     it is listed on purpose: docker-compose.yml's own healthcheck greps
	#     `HTTP/1.[01] (200|301|302|307|308)` on that path, so a rule that ever
	#     swallowed it would mark the caddy container unhealthy and stall every
	#     `docker compose up --wait`.
	#
	# Written as two matchers because a Caddyfile matcher set has no algebra —
	# there is no `not @machine_surface` to compose — and the two hooks need the
	# same partition from opposite sides. KEEP THE TWO LISTS IDENTICAL:
	# tests/surface/edge-maintenance.test.ts compares them path by path, because a
	# probe path added to one and not the other is a monitor quietly served a
	# maintenance page instead of the outage it is watching for.
	@machine_surface {
		path /api/health /api/readyz /api/* /realtime* /v1/* /healthz
	}

	@page_surface {
		not path /api/health /api/readyz /api/* /realtime* /v1/* /healthz
	}

	# The origin produced NO response: container stopped, crash loop, connection
	# refused on the compose network. reverse_proxy returns an ERROR for that
	# rather than a response, which is why this hook exists next to
	# `handle_response` in the app proxy below — the docs for handle_errors put
	# the split plainly: a directive "for example reverse_proxy which may write a
	# response with an HTTP status which is classified as an error, will _not_
	# trigger the error routes". Neither hook covers the other's half.
	#
	# OUTAGE-ONLY by these codes: 502 and 503 are "nothing behind me can serve".
	# A 500 is the application's own defect — it has a digest, a Sentry event and
	# an error boundary — and relabelling it planned maintenance closes an
	# incident nobody fixed. A 4xx or a 200 cannot reach this block at all: error
	# routes run only when a handler returned an error.
	#
	# Requests @page_surface excludes fall through, and Caddy still answers them
	# honestly: the error chain terminates in an implicit handler that writes the
	# error's own status code (caddy's errorEmptyHandler, added for #3053 precisely
	# so an error route that does not handle cannot leak a 200). Nothing here can
	# turn a probe's 502 into an indexable 200.
	#
	# The `502 503` arguments are v2.8+ (v2.7 parsed handle_errors with no
	# arguments); the box runs caddy:2-alpine and CI validates against alpine's
	# package, both comfortably past that.
	#
	# This is collected into the server's ERROR chain rather than the site's
	# route list, so its position cannot shadow /realtime, /v1 or /healthz below.
	handle_errors 502 503 {
		import maintenance_page
	}

	# Voice-plane reachability probe for the browser banner, answered by the same
	# worker that carries the calls. Kept as a distinct path rather than reusing
	# the worker's `/healthz` because that one reports live call counts, and a
	# signed-out visitor on the marketing site has no business reading a fraud
	# desk's load. `/realtime/voice-health` is inside `@machine_surface` via the
	# `/realtime*` prefix, so an unreachable worker surfaces as a bare 502 to the
	# banner instead of being wrapped in the maintenance page.
	handle /realtime/voice-health {
		rewrite * /health
		reverse_proxy voice-stream-worker:8080 {
			import forwarded_headers
		}
	}

	# Twilio Media Streams WebSocket — the voice-stream WORKER plane. A SIBLING
	# PREFIX under /realtime, deliberately NOT a route under /api: an edge matcher
	# on /api would intercept the app's own /api/voice-websocket Next.js route and
	# shadow it out of its per-route rate limiting. Matched BEFORE the broader
	# /realtime/* below (which would otherwise capture it) and before the catch-all.
	# Must stay in agreement with the wss:// URL src/worker/dial.ts builds.
	handle /realtime/media-stream {
		reverse_proxy voice-stream-worker:8080 {
			import forwarded_headers
			flush_interval -1
			transport http {
				versions 1.1 2
			}
		}
	}

	# Realtime websocket + presence, matched AFTER the more specific media-stream
	# handler above and before the catch-all, so an app route can never claim these
	# paths. Must agree with SOCKET_PATH in mini-services/realtime/src/constants.ts.
	handle /realtime/* {
		reverse_proxy realtime:4000 {
			import forwarded_headers
			# The websocket upgrade must pass through untouched: no flush delay, and
			# HTTP/1.1 enabled so `Upgrade:` is honoured.
			flush_interval -1
			transport http {
				versions 1.1 2
			}
		}
	}

	# Uptime probe answered at the edge: costs nothing and does not consume the
	# app's rate-limit bucket.
	handle /healthz {
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		respond "ok" 200
	}

	# API gateway surface. `/v1/*` is the path a bank integrates against
	# (docs/INTEGRATION-CONTRACT.md); it maps onto the app's `/api/v1/*` handler
	# so exactly one implementation exists and the public contract is a stable,
	# short, version-first path.
	#
	# Kept deliberately narrow:
	#   - A Caddy path matcher is anchored at the start of the path, so this can
	#     NEVER capture `/api/v1/*`. Do not rewrite it to a wildcard.
	#   - Authentication is NOT done here. The producer key is verified per route
	#     in the app, because that is where tenancy is resolved; a key that
	#     terminates at the edge would be a second, divergent implementation.
	handle /v1/* {
		rewrite * /api{uri}
		reverse_proxy {$APP_UPSTREAM:app:3000} {
			import forwarded_headers
			flush_interval -1
			# Canary + health checks: see the note on the main handler below.
			lb_policy round_robin
			health_uri /api/readyz
			health_interval 10s
			health_timeout 5s
			health_status 2xx
		}
	}

	handle {
		# `APP_UPSTREAM` is what makes this a BLUE/GREEN deployment: it names the
		# colour currently serving traffic (app-blue:3000 or app-green:3000), and
		# `scripts/deploy.mjs` is its only writer. The `app:3000` default keeps a
		# plain `docker compose up` working unchanged on a single-colour stack.
		#
		# ── Canary, and why there is no weighted load-balancing directive ───────
		# The variable may hold MORE THAN ONE upstream, and `lb_policy round_robin`
		# is what shares traffic between them. A canary is therefore expressed as
		# PROPORTIONAL REPETITION — 5% of traffic is the old colour listed 19 times
		# and the new colour once — which `scripts/deploy.mjs canary` generates.
		#
		# This is not the obvious implementation, so the reason is recorded:
		# Caddy 2.11.4 has NO `weighted_round_robin` lb_policy. Verified by
		# `caddy validate` against caddy:2-alpine — the policies it accepts are
		# random, round_robin, least_conn, first, ip_hash, uri_hash and cookie.
		# A `weight` subdirective is also rejected. Repetition is the mechanism
		# that actually exists, and with round_robin the split is exact over any
		# window rather than probabilistic.
		#
		# Stated plainly: round_robin is per-REQUEST, not per-session, so a canary
		# is a traffic split and not a user cohort. That is what a canary needs —
		# the goal is to expose a new build to a slice of real traffic and watch
		# Sentry — but it is not sticky, and it must not be used as A/B routing.
		reverse_proxy {$APP_UPSTREAM:app:3000} {
			import forwarded_headers
			# Next.js handles its own compression; double-compressing a streamed
			# response only adds latency.
			flush_interval -1
			lb_policy round_robin

			# Active health checks — the mechanism that makes a graceful shutdown
			# actually graceful. On SIGTERM the instance starts answering 503 from
			# /api/readyz (scripts/server-preload.ts), Caddy observes that here and
			# stops sending it NEW requests, and the in-flight ones finish against a
			# process that is still alive. Without this the instance is killed while
			# still in rotation, which is the dropped-call case.
			#
			# The URI is /api/readyz, not /api/health, and that is deliberate:
			# readiness asserts the database, so an instance that cannot serve is
			# removed rather than sent traffic it will fail. /api/health stays a pure
			# process probe for external monitors.
			health_uri /api/readyz
			health_interval 10s
			health_timeout 5s
			health_status 2xx

			# A RESPONSE matcher has to be declared inside the reverse_proxy block:
			# the Caddyfile adapter collects `@name` subdirectives into the proxy's
			# own response-matcher map and resolves `handle_response @name` against
			# that map, so a site-level definition fails to adapt with "no named
			# response matcher defined with name 'app_down'".
			@app_down {
				status 502 503
			}

			# The other half of the outage rule. The origin DID answer here, with a
			# status meaning it cannot serve: an instance still booting behind a
			# live socket, a colour mid-drain, a crash loop that gets far enough to
			# emit a gateway error. handle_errors above cannot see any of those (an
			# upstream status is not a Caddy error) and this hook cannot see a
			# refused connection (there is no response to match), so the config
			# needs both halves and neither is redundant.
			#
			# 502 and 503 only — deliberately not 5xx. A 500 is the application's
			# own defect with its own error boundary, digest and Sentry event, and
			# a 4xx is a legitimate auth or validation answer that a bank or a
			# console needs to receive as the JSON the app actually wrote.
			handle_response @app_down {
				# Machine surfaces keep the origin's response verbatim: status,
				# headers, and the app's own body. This line is not decoration —
				# inside handle_response, a route that writes nothing lets the
				# upstream body be CLOSED rather than copied (caddy's
				# reverseproxy.go: `if !hrc.isFinalized { res.Body.Close() }`), so
				# exclusion here has to be an explicit copy. handle_errors, by
				# contrast, is allowed to fall through because that chain ends in
				# an implicit writer of the error's own status.
				#
				# The consequence worth stating: /api/readyz answering 503 during a
				# graceful drain stays exactly the signal ADR-008 says it is.
				copy_response @machine_surface
				import maintenance_page
			}
		}
	}

	log {
		format filter {
			wrap console
			fields {
				# One line per field — see gotcha 3.
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Agent-Tool-Secret delete
				request>headers>SV-Signature replace "[REDACTED]" "[REDACTED]"
				# Never write a query string: signed bank payloads carry secrets in it.
				uri query replace "[REDACTED]" "[REDACTED]"
			}
		}
	}
}

# ---- sites: the hostname list ------------------------------------------------------
#
# Each block here is one hostname served by the `(site)` snippet above. Two rules
# that this file keeps getting bitten by:
#
#   · A snippet must be DEFINED before any block that imports it, or Caddy fails
#     with "File to import not found". `(site)` is above; keep it that way.
#   · Do NOT collapse these into one block driven by a comma-separated env var.
#     Caddy treats `{$VAR}` as ONE address; `{$A},{$B}` is not address expansion, and
#     the earlier attempt to do this produced "ambiguous site definition". The site
#     list has to be literal.
#
# TLS: both names are served with automatic certificates over HTTP-01. That REQUIRES
# the DNS records to be DNS-ONLY (grey cloud). Under the Cloudflare proxy (orange
# cloud) Cloudflare terminates TLS and never forwards the ACME challenge to the
# origin, so Caddy's issuance fails and `caddy validate` still passes — the failure
# only shows up at issuance time, in the logs, on the live box.
#
# To run proxied, replace the automatic cert with a DNS-01 challenge:
#   securevoiceai.me, www.securevoiceai.me {
#       tls { dns cloudflare {api_token {$CF_DNS_API_TOKEN} } }
#       import site
#   }
# `{$CF_DNS_API_TOKEN}` needs Zone:DNS:Edit for this zone. Without it, proxied +
# HTTP-01 is a silent outage for the proxied hostname only.

# Localhost — a laptop checkout and CI's compose smoke, which polls
# `https://localhost:$CI_CADDY_HTTPS_PORT` (ci.yml). Caddy issues an INTERNAL
# certificate for `localhost` (loopback names never touch ACME), so this block
# is free on every host.
#
# This block used to be `{$SITE_ADDRESS:localhost}`, and that one choice caused
# three separate failures, each measured:
#
#   1. On the production box SITE_ADDRESS names securevoiceai.me — which the
#      literal block below ALSO serves — and both at once is a fatal
#      `ambiguous site definition: securevoiceai.me` at startup.
#   2. Because both blocks could not coexist, the box carried a hand-diverged
#      copy of this file, skip-worktree'd so pulls would not trample it —
#      which made every promoted change to this file REFUSE to pull ("local
#      changes to Caddyfile would be overwritten by merge"). A Caddyfile fix
#      could not deploy without an SSH session first.
#   3. SITE_ADDRESS has an app-level job too: the canonical origin
#      (src/lib/site-origin.ts) and the Twilio media-stream URL
#      (src/worker/dial.ts) are built from it. One variable driving both the
#      edge and the app cannot be set for one without lying to the other.
#
# A literal `localhost` splits the two: Caddy serves exactly the list below,
# and SITE_ADDRESS is purely an app-level value again.
#
# This block also used to serve 57.130.80.158.sslip.io. That stand-in was
# retired 2026-10-12 — its Cloudflare record deleted, its record and tunnel
# gone, and deploy.yml / ci.yml / canary.yml now probe https://securevoiceai.me.
# Do not re-add it; a dynamic-DNS name is for issuing a certificate before the
# domain exists (docs/DEPLOY.md), not for serving one.
localhost {
	import site
}

# The real domain. Both names are DNS-ONLY (the Cloudflare record has
# proxied=false), which is what makes this block work at all.
#
# TLS here is automatic, with no `tls` directive and no certificate files — and
# that is the deliberate outcome of a long detour, so it is worth writing down
# what was tried and why it ended here.
#
#   Cloudflare proxy + Origin CA certificate   — tried three times. Each
#       certificate Cloudflare issued had NO Subject Alternative Name extension
#       at all, so it validated for zero hostnames and the edge answered 526
#       before a request reached the origin.
#
#   Cloudflare proxy + Caddy DNS-01            — tried, then reverted. The stock
#       `caddy:2-alpine` image registers NO `dns.providers.*` modules
#       (`caddy list-modules | grep dns` returns only tls.ech.publishers.mdns),
#       so naming `dns cloudflare` is a startup failure that takes EVERY hostname
#       down, not just this one.
#
#   Cloudflare proxy + HTTP-01                 — cannot work. The proxy terminates
#       TLS and never forwards the ACME challenge to the origin. It fails at
#       runtime on the box, not at `caddy validate`, which is what makes it
#       expensive: the config looks correct right up until the name stops
#       serving.
#
# So the record is DNS-only and Caddy issues its own Let's Encrypt certificate
# over HTTP-01, which works because traffic reaches the origin directly. That is
# now live and verified: `securevoiceai.me` serves a genuine LE certificate with
# `DNS:securevoiceai.me`, auto-renewing, with no certificate file to manage and
# nothing to rotate by hand.
#
# What is traded away, stated plainly: with the record grey-clouded, Cloudflare's
# DDoS protection and WAF are not in front of this hostname. The origin IP is
# directly reachable from anywhere on the internet — that is what a grey-clouded
# record means, and it never depended on the retired sslip.io name — so this is
# not a new exposure — but if the record is switched back to orange, this block
# MUST acquire a static origin certificate or it returns to the 526 above.
#
# HOST-LOCAL SITES. This file is byte-identical on every machine — the shared
# production box also fronts crucible.svalley.tech (another project), and that
# site block does NOT live here: it is an untracked `sites.d/crucible.caddy` on
# that box, pulled in by the `import sites.d/*.caddy` at the bottom. Adding a
# host is one untracked file, and commits to THIS file deploy themselves. That
# replaced the old arrangement — per-site blocks inline here in a skip-worktree'd
# box copy, which made every promoted change to this file refuse to pull until
# an operator SSH'd in and merged by hand. docs/VPS-RECOVERY.md carries the
# history (failure mode #2).
# ---- HTTP (port 80): the redirect, and it carries the headers ------------------------
#
# WHY THIS BLOCK EXISTS. Caddy generates its automatic HTTP->HTTPS redirect at
# RUNTIME, so it does not appear in `caddy adapt` output and cannot be given
# headers from the 443 site block below. Measured against the live deployment: a
# request to http://securevoiceai.me/ returned a 308 carrying only
# Location/Server/Date - while every HTTPS response carried all eight security
# headers, including on 404s and 401s. So a scanner that probes http:// first
# (most do) reported "no security headers" on a deployment that has them
# everywhere it serves content. This block makes the redirect carry them too.
#
# THE STATUS CODE IS 308, AND IT MUST STAY 308. Caddy's own redirect is a 308
# (Permanent Redirect, method-preserving). `redir ... permanent` emits 301
# instead, which lets a client rewrite a POST into a GET - a real behaviour change
# on a login POST, not a cosmetic one. Measured both ways in a container before
# and after this change.
#
# ACME: NO REGRESSION, MEASURED. Prefixing a site address with `http://` opts that
# site out of automatic HTTPS (caddyserver.com/docs/automatic-https, "Activation"),
# which is fine here - the 443 block below still owns the certificate and every
# route. The obvious worry is the HTTP-01 challenge, since a naive read says this
# block would shadow it. It does not: a control run of this config WITHOUT any
# http:// block redirects /.well-known/acme-challenge/* with a 308 too. Caddy
# registers the challenge solver on demand during an issuance, so it is invisible
# to a static probe in both cases - this block changes the response headers on the
# redirect and nothing else. Measured, not assumed.
#
# Note on what HSTS here does and does not do: RFC 6797 8.1 requires a browser to
# IGNORE Strict-Transport-Security received over plaintext, so this changes no
# browser behaviour. It exists so the header set is complete on every response a
# scanner can see, which is the whole point of the block.
http://securevoiceai.me, http://www.securevoiceai.me {
	import secure_defaults
	redir https://{host}{uri} 308
}

securevoiceai.me, www.securevoiceai.me {
	import site
}

# ---- host-local sites ---------------------------------------------------------------
#
# A wildcard import matching ZERO files is valid (measured, caddy:2-alpine) — no
# placeholder is needed, so a fresh checkout expands this to nothing. Files here
# are machine-local and untracked (.gitignore keeps only sites.d/README.md): the
# shared box's extra hostnames, one `<host>.caddy` each, a complete
# `host { import site }` block. The `(site)` snippet above is defined in this
# parent file and IS importable from here — snippets are global once defined
# (measured). Relative imports resolve against THIS file's directory, so in the
# container this is `/etc/caddy/sites.d/*.caddy` (mounted by docker-compose.yml).
#
# Editing one needs a process restart — `admin off` means there is no reload
# endpoint: `docker compose up -d --force-recreate caddy`.
import sites.d/*.caddy

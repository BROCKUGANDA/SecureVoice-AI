{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.20",
  "type": "module",
  "private": true,
  "scripts": {
    "auth:cutover": "bun scripts/assert-no-clerk.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && bun scripts/copy-standalone.mjs",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "evidence": "bun --preload ./tests/preload.ts scripts/build-evidence.ts",
    "test:agent": "bun scripts/run-agent-tests.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun scripts/seed-demo.mjs",
    "release:check": "bun run format:check && bun run lint && bunx tsc --noEmit -p tsconfig.json && bun run auth:cutover && bun run test && bun run build",
    "preflight": "bun scripts/preflight.mjs",
    "realtime:test": "cd mini-services/realtime && bun test",
    "verify": "bun run format:check && bun run lint && bunx tsc --noEmit -p tsconfig.json && bun run auth:cutover && bun run test && bun run realtime:test && bun run build",
    "version:bump": "node scripts/bump-version.mjs",
    "agent:apply": "bun scripts/agent-apply.ts",
    "agent:snapshot": "bun scripts/agent-snapshot.ts",
    "test:webhook:inbound": "bun test tests/webhooks/elevenlabs-inbound.test.ts",
    "test:webhook:outbound": "bun test tests/webhooks/outbound.test.ts",
    "test:realtime": "bun test tests/realtime/realtime.test.ts",
    "test:contracts": "bun test tests/contracts",
    "test:seams": "bun test tests/seams",
    "outbox:work": "bun --preload ./tests/preload.ts scripts/outbox-worker.ts",
    "overage:work": "bun --preload ./scripts/worker-preload.ts src/worker/overage.ts --once",
    "email:work": "bun --preload ./scripts/worker-preload.ts scripts/email-worker.ts --loop",
    "test": "bun scripts/run-tests.mjs",
    "test:unit": "bun scripts/run-tests.mjs unit",
    "test:integration": "bun scripts/run-tests.mjs tenancy auth billing privacy contracts seams routes tools console",
    "test:e2e": "bun scripts/run-tests.mjs e2e surface",
    "test:coverage": "bun scripts/coverage.mjs",
    "test:jest": "jest --config jest.config.cjs",
    "test:jest:watch": "jest --config jest.config.cjs --watch",
    "coverage:json": "jest --config jest.config.cjs --coverage --coverageReporters=lcov --coverageReporters=json --coverageReporters=json-summary --coverageReporters=text-summary",
    "test:e2e:cypress": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:coverage:fast": "bun scripts/coverage.mjs --fast",
    "test:coverage:unit": "bun scripts/coverage.mjs unit --fast",
    "deploy": "bun scripts/deploy.mjs",
    "deploy:status": "bun scripts/deploy.mjs status",
    "db:seed:audio": "bun scripts/seed-demo-audio.mjs",
    "voice:assets": "bun scripts/build-voice-assets.mjs",
    "icons": "bun scripts/build-icons.mjs",
    "paddle:seed": "bun scripts/seed-paddle-catalog.ts",
    "paddle:verify": "bun scripts/paddle-verify.ts",
    "voice:check": "bun scripts/voice-language-check.mjs",
    "integrations:check": "bun scripts/integrations-check.mjs",
    "pii:backfill": "bun --preload ./scripts/worker-preload.ts scripts/backfill-case-phone-vault.ts",
    "paddle:repair-overrides": "bun scripts/paddle-repair-overrides.ts"
  },

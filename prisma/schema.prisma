// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Inbound pilot / partnership requests submitted from the public site.
/// Minimal personal data by design (PDPL-aware): contact + institution only.
model PilotRequest {
  id          String   @id @default(cuid())
  ref         String   @unique // human-friendly reference, e.g. SV-P-8F3K2
  name        String
  email       String
  institution String
  role        String?
  volume      String? // monthly card volume band, self-reported
  message     String?
  source      String   @default("website") // website | deck | referral
  status      String   @default("new") // new | contacted | qualified | closed
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
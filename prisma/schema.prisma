// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // `relationJoins` makes `relationLoadStrategy: "join"` available, which
  // resolves a relation with a single LATERAL JOIN instead of one extra query
  // per parent row (Prisma's default `relationLoadStrategy: "query"`). On the
  // console list endpoints — cases × member × organization, the inbox, the
  // knowledge-base document list — that is the difference between one round
  // trip and N, and the test database is a REMOTE Postgres with a ~280 ms round
  // trip, so N+1 there is measured in seconds.
  //
  // It is a PER-QUERY opt-in, not a global switch: enabling the flag changes no
  // behaviour until a query sets `relationLoadStrategy: "join"`. Deliberately so
  // — a join is not universally faster (a one-to-many with a large child set
  // can lose to two indexed queries), so the choice belongs at the call site
  // where the cardinality is known.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String       @unique
  name             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  emailVerified    Boolean      @default(false)
  image            String?
  twoFactorEnabled Boolean?     @default(false)
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  /// Written by the Better Auth `dash` plugin's activity tracking
  /// (`activityTracking.enabled`). Also read by `sentinel`'s stale-user check —
  /// `checkStaleUser(userId, activityTrackingEnabled ? user.lastActiveAt : null)`
  /// — which is INERT while this column is absent or tracking is off, because
  /// it is then handed `null` on every call. Nullable and additive: an existing
  /// row simply has no recorded activity until the next update tick.
  lastActiveAt     DateTime?
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]
  profile          UserProfile?

  @@map("user")
}

/// Inbound pilot / partnership requests submitted from the public site.
/// Minimal personal data by design (PDPL-aware): contact + institution only.

model PilotRequest {
  id          String   @id @default(cuid())
  ref         String   @unique // human-friendly reference, e.g. SV-P-8F3K2
  name        String
  email       String
  institution String
  role        String?
  volume      String? // monthly card volume band, self-reported
  message     String?
  source      String   @default("website") // website | deck | referral
  status      String   @default("new") // new | contacted | qualified | closed
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Idempotency-Key store for upstream API calls (TTS, ASR, agent turns).
/// Persists a (caller, key) → response payload for 24h so a retry is a free
/// replay rather than a second billable call. Concurrent same-key requests
/// dedupe via the unique composite key on (scope, key).

model IdempotencyKey {
  id         String   @id @default(cuid())
  scope      String // "tts" | "asr" | "agent" — narrows dedup to the right surface
  key        String // SHA-256 of the canonical request payload
  callerId   String // x-caller-id header (or "anon" if absent)
  response   String // JSON-stringified response (TTS: empty + audio stored elsewhere; ASR/agent: full body)
  statusCode Int      @default(200)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([scope, key, callerId])
  @@index([expiresAt])
}

/// Tamper-evident call audit log. Every agent turn + TTS call + ASR call
/// appends one row. chainHash = sha256(prevHash || canonicalRow), so any
/// modification breaks the chain and `verifyChain()` can detect it.

model AuditLog {
  id           String   @id @default(cuid())
  callRef      String // human reference for the call (e.g. SV-C-8F3K2)
  action       String // "tts" | "asr" | "agent" | "freeze" | "handoff"
  intent       String? // agent decision (deny_fraud | confirm_authorized | greeting | unclear)
  callerId     String? // x-caller-id or "anon"
  redactedText String? // redacted transcript snippet (PII removed)
  meta         String? // JSON-stringified metadata (lang, voice, latencyMs, etc.)
  prevHash     String? // chain link
  chainHash    String   @unique
  orgId        String? // organization scoping (multi-tenant groundwork)
  createdAt    DateTime @default(now())

  @@index([callRef, createdAt])
  @@index([orgId, createdAt])
  @@index([createdAt])
}

/// Isolated PII vault. Raw sensitive values are stored here only; the main
/// `interventions` table stores token references.
model PIIVault {
  token         String   @id @default(cuid())
  orgId         String
  encryptedValue String
  type          String // "phone" | "name" | "pan" | "address"
  /// Deterministic HMAC of `orgId|type|normalised value` under a key derived from
  /// `AUTH_SECRET` in its own domain (`sv-blind:`), so re-sealing the same value for
  /// the same tenant returns the SAME token instead of accumulating a second vault
  /// row per case. It includes the org on purpose: this index exists to dedupe
  /// within a tenant, and an org-scoped message means a database reader cannot use
  /// it to discover that one customer banks at two of this platform's tenants.
  /// NULL on rows sealed before it existed, and Postgres treats NULLs as distinct,
  /// so the unique index does not reject them.
  blindIndex    String?
  createdAt     DateTime @default(now())

  @@unique([orgId, type, blindIndex], map: "pii_vault_org_type_blind_uniq")
  @@index([orgId, type])
  @@map("pii_vault")
}

/// Registered ElevenLabs voice personas with consent metadata.
/// Cloning endpoints refuse a voice without a recorded consent URL + timestamp.

model OnboardingState {
  userId         String    @id @db.Uuid
  /// Steps the user has completed, newest last. A JSON array of step ids rather
  /// than a row per step: the list is read and written as one unit, it is tiny,
  /// and it keeps "has this user finished onboarding" to a single indexed read
  /// instead of a count() on the hot path of every page load.
  completedSteps String    @default("[]")
  /// Set when the user explicitly skips. Distinct from "finished": a returning
  /// user who skipped must never be shown the tour again, but must still be able
  /// to open the guide deliberately. Collapsing these two states is how you get
  /// either a tour that nags a power user or a guide nobody can find.
  skippedAt      DateTime?
  /// Monotonic count of sessions completed, used only to prove the "skip
  /// returning users" rule is doing something rather than being decorative.
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Institution knowledge-base document (RAG source of truth).
///
/// A bank uploads its own policy PDFs here; the platform extracts the text,
/// chunks it, embeds the chunks and stores the vectors in Pinecone under a
/// strict `orgId` metadata filter. The raw PDF bytes are retained so a failed
/// vectorization can be retried without asking the bank to upload again.
///
/// A second plane is optional and off by default: the same extracted text can also
/// be published as a document on the ElevenLabs agent itself (`platformDocId`), so
/// the live call can quote the bank's policy without going through Pinecone. The
/// two planes fail independently, which is why the row carries a separate reason
/// column for the platform side.
model Document {
  id           String    @id @default(cuid())
  /// Tenant scope. Every query — vector and row — filters on this.
  orgId        String
  title        String
  fileName     String
  mimeType     String    @default("application/pdf")
  sizeBytes    Int
  lang         String    @default("en")
  /// PENDING | CHUNKING | EMBEDDING | READY | FAILED (src/lib/knowledge/documents.ts)
  status       String    @default("PENDING")
  chunkCount   Int       @default(0)
  /// Failure reason when status = FAILED (e.g. pinecone_not_configured)
  error        String?
  /// Raw upload, capped at MAX_DOC_BYTES. Kept so Retry re-runs extraction +
  /// embedding without a second upload; deleted with the row.
  pdfBytes     Bytes?
  vectorizedAt DateTime?
  /// ElevenLabs platform-KB document id, when this row has been published to the
  /// conversation plane's own knowledge base (src/lib/knowledge/platform-kb.ts).
  ///
  /// This column IS the idempotency record: a retry PATCHes the document it names
  /// instead of POSTing a second copy of the same policy onto the vendor — the
  /// failure every other retry in this product is built to avoid. Nothing already
  /// in the row can hold it (`error` means "the RAG document is broken",
  /// `vectorizedAt` is a timestamp), so the column is unavoidable.
  platformDocId String?
  /// Why the platform publish failed for a row whose tenant-side vectorization
  /// SUCCEEDED. Kept out of `error` deliberately: the console renders `error` next
  /// to a Retry button that re-embeds a PDF, and a document that embedded fine
  /// must never read as broken. Cleared when a later run publishes it.
  platformError String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orgId, createdAt])
}

/// Per-user onboarding progress.
///
/// Signup is invite-only, so every account here was invited by a bank, and an
/// invited operator arrives with no idea what the console does. This records how
/// far through the guide they are so progress is RESUMABLE rather than restarted,
/// and so a returning user is not made to sit through it again.
model Voice {
  id          String    @id @default(cuid())
  voiceId     String    @unique // ElevenLabs voice_id or our internal slug
  language    String // BCP-47 (en-US, ar-AE, hi-IN, ur-PK, fr-FR, bn-BD)
  displayName String
  isCloned    Boolean   @default(false)
  consentUrl  String? // required if isCloned=true
  consentAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// Platform accounts. Two seeded credentials on every fresh database:
///   operator@securevoice.ae — full platform access (Command Center: fire real
///     interventions to their own enrolled phone, inspect audit chains)
///   demo@securevoice.ae — demo mode (guided simulation only)
/// Sign-up through the API always creates "demo" role; operator is seed-only.

model Account {
  id                    String    @id @default(cuid())
  // Nullable, not required. This table is Better Auth's `account` model (the
  // CLI merged it into the pre-existing Account model because Prisma model
  // names are case-insensitively unique), and Better Auth's own credential
  // signup inserts ONLY accountId/providerId/userId/password/createdAt/
  // updatedAt. Leaving these three NOT NULL made every Better Auth sign-up
  // fail with a not-null violation while the first-party scrypt path in
  // src/lib/auth/password.ts kept working, which is exactly the kind of
  // half-migrated state that looks fine until a real user tries to log in.
  //
  // They are nullable rather than defaulted because a default of "" would
  // collide with the unique index on the second insert.
  email                 String?   @unique
  name                  String?
  role                  String    @default("demo") // operator | demo
  // scrypt$salt$hash (node:crypto), written only by the first-party path.
  // Better Auth's own hashes live in the `password` column below.
  passwordHash          String?
  createdAt             DateTime  @default(now())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Machine-to-machine producer keys for the headless API. A bank's fraud
/// engine authenticates with `Authorization: Bearer svb_¦` instead of HMAC.
/// Only the SHA-256 hash is stored — the plaintext key is shown once at creation.

model ProducerKey {
  id         String    @id @default(cuid())
  label      String
  keyHash    String    @unique // sha256 of the plaintext svb_ key
  orgId      String? // tenant scoping for signals fired with this key
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

/// Per-tenant agent-tool credentials (bleedguard).
///
/// `AGENT_TOOL_SECRET` is one deployment-wide secret, so any caller holding it
/// could name ANY org's conversation_id and have that case resolved, frozen or
/// read. This table makes the credential itself carry the tenant: the presented
/// secret is hashed, the row it matches names the org, and the tool-guard then
/// scopes the case lookup by that org. A leaked secret now reaches exactly one
/// tenant instead of all of them.
///
/// Mirrors `ProducerKey` deliberately — same hash-only storage, same
/// revocation column, same last-used stamp — so there is one credential
/// convention in this codebase rather than two.
model AgentToolSecret {
  id           String       @id @default(cuid())
  label        String
  keyHash      String       @unique // sha256 of the plaintext svt_ secret
  orgId        String       @db.Uuid // the ONE tenant this credential may act for
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  revoked      Boolean      @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

/// Better Auth-backed platform profile + prepaid credits wallet (1 credit = 1
/// intervention signal). The Better Auth `user` row is the identity; this row
/// carries the billing state. Roles come from organization membership
/// (auth.api.getActiveMember), NOT from a self-editable field on the user row.
///   operator → 500 credits · demo/analyst → 25 credits

model UserProfile {
  id            String        @id @default(cuid())
  // References the Better Auth `user` row. Renamed from clerkUserId at the
  // Clerk -> Better Auth cutover; the column type moves to uuid because
  // better-auth.ts sets advanced.database.generateId = "uuid" so the id is a
  // proper UUID rather than a cuid.
  //
  // Tenant isolation note: RLS is enforced at the database layer via migration
  // `9zzzzzzzzzzzzzzzzzzzzzz_tenant_rls` and
  // `9zzzzzzzzzzzzzzzzzzzzzzz_tenant_rls_coverage`. The policies compare
  // `"orgId"` against `current_setting('app.org_id')` inside a transaction
  // that has run `SET LOCAL ROLE sv_tenant`. The connecting role is a superuser
  // with BYPASSRLS, so the policies bind only inside `withTenantScope` — see
  // `src/lib/tenancy/db-scope.ts` for the enforcement path and the documented
  // plan to move the deployment onto a least-privilege database user.
  userId        String        @unique @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  name          String
  role          String        @default("demo") // operator | demo
  // The organization IS the tenant (hazard AU-3), so this points at the
  // Better Auth organization row rather than holding a foreign id string.
  orgId         String?       @db.Uuid
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  orgName       String? // white-label: organization display name
  orgLogoUrl    String? // white-label: logo shown in the Command Center
  elevenKeyEnc  String? // BYOK ElevenLabs key, AES-256-GCM encrypted at rest
  ttsCharsDate  String? // platform-key voice metering day (YYYY-MM-DD)
  ttsCharsToday Int           @default(0) // chars synthesized on the platform key today
  credits       Int           @default(25)
  // BYOK OpenAI-compatible LLM key (AES-256-GCM) + its base URL. Preferred
  // over the deployment's Groq/LiteLLM/Gemini env chain when set, so an
  // institution can route the rephrase step through its own account.
  llmKeyEnc     String?
  llmBaseUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orgId])
}

/// Enrolled customer for live delivery (voice/SMS). A bank's signed-up customer
/// who can receive fraud-intervention calls and alerts on their phone.
/// PII discipline: phone is stored for dialing (never logged raw — audit rows
/// carry redacted values only), customerRef is the bank's own identifier.

model Customer {
  id              String   @id @default(cuid())
  customerRef     String   @unique // bank's customer identifier (no PII, e.g. CUST-8642)
  phone           String // E.164 (+9715¦), the dial target
  lang            String   @default("en") // en | ar | hi | ur
  channel         String   @default("call") // preferred delivery: call | sms
  consentRecordId String? // recorded outbound consent (PDPL) — required for enroll
  optedOut        Boolean  @default(false) // STOP honoured instantly, no delete (audit trail)
  orgId           String? // organization scoping (multi-tenant groundwork)
  enrolledAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([optedOut])
  @@index([orgId])
}

/// Fraud intervention case — the canonical state machine record.
/// One enum, one writer (src/lib/case-state-machine.ts), no exceptions.

model Case {
  id                    String    @id @default(cuid())
  caseRef               String    @unique // SV-F-XXXXXX — the public case reference
  orgId                 String? // tenant scoping
  state                 String    @default("RECEIVED") // see case-state-machine.ts
  conversationId        String? // ElevenLabs conversation_id — join key for post-call webhook
  transactionRef        String?
  riskScore             Float?
  language              String    @default("en")
  phone                 String? // E.164, redacted in audit
  merchant              String? // sanitised
  amountMinor           Int?
  currency              String?
  consentRecordId       String?
  freezeStaged          Boolean   @default(false)
  /// Out-of-band verification word for this case (src/lib/verification-token.ts).
  ///
  /// STORED AS A HASH, and never spoken by the agent. It exists so the customer
  /// can confirm on a second channel that a verification call is genuinely in
  /// progress — the same role the case reference plays in the pre-announcement
  /// SMS, but for the CALL rather than the EVENT. Hashing costs nothing here and
  /// means a database dump yields no usable token; the plaintext is returned
  /// exactly once, at case creation, to the bank integration that renders it in
  /// the customer's app.
  verificationTokenHash  String?
  verificationTokenAt    DateTime?
  freezeReference       String?
  // The reversal window is a clock, not a number in an audit payload. All three
  // are written by src/lib/case-state-machine.ts (staging) and the two routes
  // that move a staged hold, never by a webhook.
  /// When the hold was staged. `REVERSAL_WINDOW_SECS` runs from here.
  freezeStagedAt        DateTime?
  /// A step-up-authenticated human committed the hold. The actor lives in the
  /// audit chain; this column exists so a reader can tell "a specialist held
  /// this card" from "nobody acted and the window closed" — both leave the case
  /// in ESCALATED.
  freezeCommittedAt     DateTime?
  /// The window closed with no commit. Set by the expiry sweep, which escalates
  /// (a page) rather than reverses: nothing was ever frozen at the bank, so
  /// there is no freeze to unfreeze.
  freezeLapsedAt        DateTime?
  handoffQueued         Boolean   @default(false)
  handoffSpecialist     String?
  // Post-call ingest (WP-4): the conversation record becomes billing truth
  // and the bank notification. Transcript is stored redacted only (I-10).
  postCallAt            DateTime?
  postCallEventType     String?
  outcome               String? // analysis.call_successful / evaluation verdict
  durationSeconds       Int? // from the conversation metadata (billing reconcile)
  transcriptRedacted    String?
  evaluationResults     String? // JSON string of analysis.evaluation_criteria_results
  dataCollectionResults String? // JSON string of analysis.data_collection_results
  // Reachability. When the voice call does not reach a human the platform sends
  // a "blind ping" SMS (no merchant, no amount) and waits for YES / NO. These
  // columns are additive and nullable - see 9zz_unreachable_resolution.
  cardLast4             String? // lets the customer recognise the alert without a merchant/amount
  signalKind            String? // card_transaction | claim_payout | policy_change | account_takeover
  // WHY the institution is calling (src/lib/call-categories.ts). Null reads as
  // the audited default (time_critical_fraud) — see asCallCategory.
  callCategory          String?
  // PII minimization: tokenized references into `pii_vault`. The raw values
  // must never be stored here; these columns exist so joins can resolve tokens
  // when a privileged, scoped operation requires them.
  customerPhoneToken    String?
  customerNameToken     String?
  /// HMAC of the normalised destination number under `sv-blind:` — deliberately
  /// WITHOUT the org in its message, unlike the vault's own dedupe index.
  ///
  /// This column exists so a callback can be matched to its case at all. Two live
  /// paths receive a customer's number and hold no tenant: an inbound SMS reply
  /// (`src/lib/sms-verdict.ts` matches a YES/NO to the alert it answers) and an
  /// inbound voice callback that has not identified the org yet. An org-scoped
  /// index could not be computed from either, which is what kept the plaintext
  /// `phone` column load-bearing.
  ///
  /// The correlation it gives a reader with full database access — "this number
  /// appears in these tenants" — is the same one the plaintext column already gave
  /// them, row by row. It is not a new exposure, and it is what lets the plaintext
  /// go. RLS still confines every application read to one tenant's rows.
  phoneIndex            String?
  // The Twilio call-leg sid, persisted at dial time. The warm_transfer tool
  // rewrites this leg's TwiML to bridge the customer to a live human.
  callSid               String?
  smsSentAt             DateTime? // anchors the 24h reply window
  resolutionMethod      String? // voice_call | sms_reply_yes | sms_reply_no | unreachable_no_reply | ...
  customerResponse      String? // "yes" | "no" | null (null = the customer never answered)
  // Crypto-shredding (WP-15). Erasure destroys the data key, which makes every
  // encrypted payload undecryptable while the audit chain — which stores only
  // hashes — still verifies from genesis. That is how right-to-erasure
  // coexists with an immutable log.
  dataKeyEnc            String?
  erasedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One intervention call per bank transaction.
  //
  // This is the ATOMIC backstop behind the policy gate's transaction_repeat
  // check. A read cannot settle a race: two signals carrying different
  // Idempotency-Keys but the same transaction_ref can both read "no prior case"
  // and both proceed to dial, and a fraud victim then receives two "your card is
  // frozen" calls about one transaction. The unique index is what makes the
  // second INSERT fail at the database, which is the only place a race can
  // actually be decided.
  //
  // Partial (WHERE transactionRef IS NOT NULL) because the column is nullable:
  // a plain composite unique would treat every NULL as a distinct value in
  // Postgres anyway, but the partial form states the intent and keeps the index
  // small when many cases predate the field.
  @@unique([orgId, transactionRef], map: "Case_orgId_transactionRef_key")
  @@index([orgId, state])
  @@index([orgId, createdAt])
  @@index([conversationId])
  @@index([phone, smsSentAt], map: "Case_phone_smsSentAt_idx")
  // The reply-matching lookup's shape, once the plaintext column is gone: a
  // customer's number and the SMS window it is answering.
  @@index([phoneIndex, smsSentAt], map: "Case_phoneIndex_smsSentAt_idx")
  // The reversal-window sweep runs every tick across ALL tenants (it is a
  // platform duty, not a tenant console list), and it is bounded by the staging
  // timestamp, so it needs the state + clock pair. Without it the sweep is a
  // sequential scan of the case table on the same tick as the dial drain.
  @@index([state, freezeStagedAt])
  // Every live turn looks its case up by the provider's channel id:
  // `findFirst({ where: { callSid } })` in the Twilio turn route and the media-stream
  // worker, and again in ai-authz before a freeze is staged. None of those three had
  // an index, so each of them was a sequential scan of the case table on the path
  // where a customer is holding the line and waiting to hear something.
  @@index([callSid])
}

/// A phone number that replied STOP. Never texted again by this platform,
/// whichever tenant's case fires next: the opt-out belongs to the person.
model SmsSuppression {
  phone     String   @id // E.164
  reason    String
  createdAt DateTime @default(now())
}

/// Voice do-not-call registry (src/lib/call-categories.ts). A number here must
/// not receive routine or non-critical outbound calls; time-critical fraud
/// verification is consent-record-backed and deliberately not gated on it.
model DoNotCall {
  phone     String   @id // E.164
  reason    String
  createdAt DateTime @default(now())
}

/// The telecom outbox (src/lib/telecom-outbox.ts): the lifecycle of every
/// outbound call and SMS, org-scoped. Twilio status callbacks update `status`
/// by `providerSid`; `payload` carries the exact text sent (never a merchant
/// or an amount).
model TelecomEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?  @db.Uuid
  caseId      String?
  channel     String // voice | sms
  toPhone     String
  fromPhone   String
  providerSid String?
  status      String   @default("queued") // queued | in_progress | sent | delivered | failed
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([providerSid])
  @@index([caseId])
}

/// Quarantine, written ONCE by migration `9z_case_transaction_ref_unique`: the
/// case rows it deleted so the unique `transactionRef` index could exist. Which
/// row survived was not arbitrary (the earliest, because that is the one that was
/// dialled and therefore the one whose audit chain and recording exist), but a
/// deleted row is still evidence — recoverable by hand if a "duplicate" turns out
/// to have been two banks genuinely transacting on one reference.
///
/// There is no read path and none is wanted. It is declared here because the CI
/// drift gate asks whether `prisma/migrations` and this file describe the same
/// database, and a table the database has that the schema denies is precisely
/// what that gate exists to catch.
model TransactionRefDuplicate {
  id             String    @id
  caseRef        String
  orgId          String?
  transactionRef String?
  state          String?
  conversationId String?
  createdAt      DateTime?
  quarantinedAt  DateTime  @default(now())
}

/// One row per inbound ElevenLabs delivery (verified signature) — the
/// processing registry and the dedupe record. Unique per
/// (provider, eventType, conversationId, eventTimestamp): an exact redelivery
/// is a replay and creates nothing new. Not processed rows may be retried.

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String    @default("elevenlabs")
  eventType      String
  conversationId String?
  agentId        String?
  eventTimestamp Int?
  processed      Boolean   @default(false)
  error          String?
  processedAt    DateTime?
  receivedAt     DateTime  @default(now())

  @@unique([provider, eventType, conversationId, eventTimestamp])
  @@index([processed])
  @@index([conversationId])
}

/// Inbound webhooks that could not be correlated to a case land here — never
/// silently dropped (WP-4 step 4). Redacted transcript excerpt only.

model WebhookQuarantine {
  id                 String   @id @default(cuid())
  eventType          String
  conversationId     String?
  reason             String
  transcriptRedacted String?
  eventTimestamp     Int?
  createdAt          DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

/// Transactional outbox (WP-5). The case transition and this row commit in
/// the SAME transaction, so a verdict can never exist without its delivery.
/// PENDING -> SENDING -> DELIVERED, or -> DEAD after the retry ladder
/// exhausts (then a DeadLetter row exists for manual replay).

model OutboxEvent {
  id            String    @id @default(cuid()) // also the event_id the bank deduplicates on
  orgId         String?
  caseRef       String?
  eventType     String // e.g. case.notified
  payload       String // canonical JSON body actually signed and sent
  targetUrl     String
  state         String    @default("PENDING") // PENDING | SENDING | DELIVERED | DEAD
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([state, nextAttemptAt])
  @@index([caseRef])
}

/// Dead-letter table: deliveries that exhausted the retry ladder.
/// Manual replay (admin-only endpoint) re-queues the matching OutboxEvent.

model DeadLetter {
  id         String    @id @default(cuid())
  eventId    String    @unique // OutboxEvent.id
  eventType  String
  caseRef    String?
  payload    String
  targetUrl  String
  error      String
  attempts   Int
  replayedAt DateTime?
  failedAt   DateTime  @default(now())

  @@index([failedAt])
}

/// Durable dial queue (WP-19). Call placement leaves the request handler and
/// becomes a row, so a campaign burst queues instead of overwhelming the
/// telephony provider, and a killed worker loses its lease rather than the job.
/// The unique index on (caseId, attemptNo) is the exactly-once dial guarantee.

model DialJob {
  id             String    @id @default(cuid())
  caseId         String    @map("case_id")
  caseRef        String    @map("case_ref")
  orgId          String?   @map("org_id")
  attemptNo      Int       @default(1) @map("attempt_no")
  retries        Int       @default(0)
  state          String    @default("PENDING")
  priority       Int       @default(0)
  payload        String
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  claimedBy      String?   @map("claimed_by")
  lastError      String?   @map("last_error")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([caseId, attemptNo], map: "dial_job_case_id_attempt_no_key")
  @@index([state, availableAt, priority], map: "dial_job_state_available_at_priority_idx")
  @@index([state, leaseExpiresAt], map: "dial_job_state_lease_expires_at_idx")
  @@index([caseId], map: "dial_job_case_id_idx")
  @@index([state, createdAt], map: "dial_job_state_created_at_idx")
  @@map("dial_job")
}

/// Transactional email queue (magic link, invite, password reset).
///
/// This is deliberately a SEPARATE table from OutboxEvent. OutboxEvent is the
/// signed bank-webhook outbox: it requires a tenant endpoint, a signing secret
/// and a canonical-JSON payload, none of which apply to an email. Reusing it
/// would put an email in a table whose `targetUrl` column is then either NULL
/// or a lie, and would route a sign-in credential through bank-delivery
/// replay tooling that assumes a signed payload.
///
/// Why a queue at all: these three emails each carry a live credential. If
/// Resend is briefly unavailable, fire-and-forget loses the message permanently
/// and the operator is told "check your inbox" for mail that was never sent.
/// With a row, the caller learns the send failed (HTTP 503) AND a worker
/// retries with backoff, so a transient provider blip does not lock an analyst
/// out of a fraud console.
///
/// NOTIFICATION ADDRESSES ARE STORED. The recipient is retained so support can
/// answer "did the invite reach X?" and so a bounced address can be suppressed
/// before it is mailed again. See docs/SECURITY.md — this table holds personal
/// data and is inside the RLS boundary like every other tenant-scoped row.
///
/// The TOKEN IS NOT STORED. `payload` holds the rendered subject/body/labels
/// needed to retry a send, never the URL's query string. A queued row that
/// outlived its token's expiry would otherwise be a credential in the database.
model EmailOutbox {
  id        String   @id @default(cuid())
  /// Tenant scope. Added by `9zzzzzzzzzzzzzzzzzzzzzzz_tenant_rls_coverage` because
  /// the comment below claimed this table was "inside the RLS boundary like every
  /// other tenant-scoped row" while it carried no organisation column at all, so
  /// there was nothing to be inside.
  ///
  /// NULLABLE and additive: a row written before the column existed has no
  /// recoverable owner, so it keeps a null orgId and falls to the same
  /// default-deny every other null-orgId row gets from the policy — an unknown
  /// owner is not an authorisation.
  ///
  /// The AUTH kinds (magic link, invite, password reset) are pre-session by
  /// construction and keep writing null — for those rows null is not a bug to
  /// fix but the correct value. The first flow that DOES know its tenant is the
  /// console's support ticket (POST /api/support/ticket): it stamps the
  /// session-derived org id (`enqueueAndSendEmail({ orgId })`), which is what
  /// this column and its tenant_scope policy were added for.
  orgId     String?
  /// Which flow produced this: magic_link | invite | password_reset |
  /// pilot_request | support_ticket.
  kind      String
  /// The address being mailed. Personal data: redact in logs, never in metrics.
  toEmail   String
  /// Rendered subject, stored so a retry does not depend on re-rendering a
  /// template that may have changed since the row was written.
  subject   String
  /// Canonical JSON: { template, props } with all credential-bearing props
  /// stripped. Retry re-renders from this.
  payload   String
  state     String   @default("PENDING") // PENDING | SENDING | SENT | DEAD
  attempts  Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  sentAt    DateTime?
  /// The provider's own id for the accepted message (`Resend` returns it from
  /// `emails.send`). This is the JOIN KEY that makes delivery webhooks
  /// actionable: `email.bounced` / `email.delivered` / `email.complained` /
  /// `email.delivery_delayed` identify the message ONLY by this id, so without
  /// it stored at send time a bounce cannot be matched back to the row that
  /// caused it and the address is retried until the ladder exhausts.
  ///
  /// Nullable on purpose: rows written before this column existed, and sends
  /// where the provider returned no id, have none — those fall back to
  /// "unmatched", which is reported rather than silently swallowed.
  providerMessageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([toEmail])
  @@index([createdAt])
  @@index([providerMessageId])
  @@index([orgId, createdAt], map: "EmailOutbox_orgId_createdAt_idx")
}

/// Inbound email received on the support/legal/founder mailboxes.
///
/// The send side is `EmailOutbox` (one row per message we send). This is the
/// mirror: one row per message a human or a bank sent US, captured by the
/// Resend `email.received` webhook at `POST /api/email/inbound`.
///
/// Bodies are stored REDACTED and truncated: an inbound email is untrusted
/// content and, in a bank integration, may quote a customer's PII. The row is a
/// triage record, not an archive — the mailbox itself holds the original.
model EmailInbound {
  id           String   @id @default(cuid())
  /// Tenant scope, same column and same null-means-service-path rule as
  /// EmailOutbox.orgId. Inbound mail is untrusted and may quote a customer's PII,
  /// so "which tenant's inbox is this" is the first question a reviewer asks of
  /// the row — it was unanswerable before this column.
  orgId        String?
  /// Resend's message id. The idempotency key: a provider retry must not
  /// create a second row.
  messageId    String   @unique
  /// The mailbox it arrived on: support@ | legal@ | founder@ | unknown.
  recipient    String
  fromEmail    String
  fromName     String?
  subject      String
  /// Redacted + truncated body text. Never the raw HTML.
  bodyText     String
  /// Attachments are recorded by name only; the bytes stay with the provider.
  attachmentNames String @default("[]")
  /// Sender's verdict from Resend: delivered | bounced | spam | null.
  verdict      String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([recipient, receivedAt])
  @@index([fromEmail])
  @@index([receivedAt])
  @@index([orgId, receivedAt], map: "EmailInbound_orgId_receivedAt_idx")
}

/// Deliveries received by the in-app receiver (the /inspector demo surface,
/// and the fixture a bank integration team can point its own tests at).

model InboundBankEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  eventType       String
  caseRef         String?
  signatureValid  Boolean
  signatureHeader String?
  body            String
  receivedAt      DateTime @default(now())

  @@index([receivedAt])
}

/// In-app notification inbox (WP-20). One row per (org, alert type, window) so
/// a burst that would otherwise page a human 500 times arrives as ONE alert
/// with a count. Escalation advances through the contact ladder until a human
/// acknowledges it — an unacknowledged page is a real capability gap, not a
/// UI detail.

model Notification {
  id             String    @id @default(cuid())
  orgId          String?
  caseRef        String?
  alertType      String // fraud_confirmed | escalation | case_stuck | billing_anomaly
  severity       String    @default("info") // page | urgent | info
  title          String
  body           String?
  dedupeKey      String    @unique // {orgId}:{alertType}:{windowBucket}
  windowMinutes  Int       @default(0)
  count          Int       @default(1)
  contactIndex   Int       @default(0)
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  acknowledgedAt DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, acknowledgedAt])
  @@index([alertType])
}

/// Append-only usage ledger (WP-13). There is NO mutable credits column: the
/// balance is the sum of these rows, which is what makes it auditable and race
/// free. All amounts are INTEGER minor units — never floats.

model UsageLedger {
  id           String   @id @default(cuid())
  orgId        String?
  caseRef      String?
  attemptNo    Int      @default(1)
  kind         String // reserve | consume | release | topup | refund
  units        Int // signed by kind: reserve/consume/topup positive, release/refund negative
  reason       String?
  /// Idempotency key: {caseRef}:{attemptNo}:{kind}. The unique index is the
  /// guarantee against double-charging on a retried webhook, not the retry logic.
  idemKey      String   @unique
  balanceAfter Int?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([caseRef])
}

/// A settled or pending payment (WP-13). Written by a PaymentProvider adapter
/// only — no domain code touches a gateway type.

model PaymentRecord {
  id               String    @id @default(cuid())
  orgId            String?
  provider         String // manualinvoice | paystack | flutterwave | paddle
  reference        String    @unique // our reference, generated by us (idempotency key)
  amountMinor      Int
  currency         String
  status           String    @default("pending") // pending | success | failed | refunded
  entitlementsJson String?
  verifiedAt       DateTime?
  verifiedBy       String? // operator who confirmed a manual invoice (dual control)
  createdAt        DateTime  @default(now())

  @@index([orgId, createdAt])
}

model Session {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String
  logo                String?
  // White-label primary colour, `#rrggbb` lower case, or null for the platform
  // default. Stored ALREADY VALIDATED: `src/lib/brand/color.ts` refuses a hex
  // that fails the WCAG contrast gate, so this column cannot hold a colour that
  // would render unreadable text. The derived foreground is NOT stored — it is a
  // pure function of this value, and a second column is a second answer.
  //
  // Why it lives on Organization rather than in `metadata`: metadata is an opaque
  // JSON string with no constraint, and this value is read on every console
  // paint and written from a settings form that has to be able to reject it.
  brandPrimary        String?
  createdAt           DateTime
  metadata            String?
  members             Member[]
  invitations         Invitation[]
  profiles            UserProfile[]
  toolSecrets         AgentToolSecret[]
  // Provider binding for inbound ElevenLabs events (bleedguard). The webhook
  // payload names the agent that produced it, so this is the tenant the event
  // belongs to — which is what lets the post-call correlation resolve the case
  // org-scoped instead of trusting the shared platform secret.
  elevenAgentId       String?           @unique
  elevenPhoneNumberId String?           @unique
  // "bank" | "insurer". Both are tenants, operators and vendors of the platform;
  // this only changes how the institution is spoken about to ITS customers
  // ("your card" vs "your policy"). Default keeps every existing tenant a bank.
  institutionType     String            @default("bank")
  // Per-tenant telecom identity (src/lib/institution.ts getTelecomIdentity).
  // The org's OWN Twilio surface: the number customers call back, and the SMS
  // sender identity. The ElevenLabs-path caller ID is `elevenPhoneNumberId`
  // above. Empty falls back to the platform defaults.
  twilioVoiceNumber           String?
  twilioSmsSenderId           String?
  twilioMessagingServiceSid   String?
  // Abuse/plan tier for this organisation. When set, overrides the deployment
  // default (`ABUSE_PLAN_TIER`). Accepted values: `demo` | `standard`
  // | `enterprise`. Null falls through to the default, which is `demo`.
  planTier                    String?
  // Islamic institution (Islamic bank or takaful operator). Drives the speech
  // gate's terminology substitution ONLY. Conventional tenants must not have
  // "insurance"/"premium" rewritten to "takaful"/"contribution" — that would
  // describe their own product to the customer incorrectly, which is the same
  // class of harm the filter exists to prevent.
  shariahCompliant            Boolean         @default(false)
  // Where this institution's own systems are told what happened. Without it the
  // platform posts every outcome to the single deployment-wide BANK_WEBHOOK_URL,
  // which means a bank can only ever receive results by us reading one shared
  // queue — not by its own integration being called. Null falls back to that
  // deployment default, which is what a single-tenant pilot uses.
  vendorWebhookUrl            String?
  // HMAC key for the vendor endpoint, AES-256-GCM sealed with the BYOK master
  // key (src/lib/byok.ts). Stored sealed because signing an outbound webhook
  // requires recovering the plaintext, unlike an inbound key which is only ever
  // verified and could therefore be hashed.
  vendorWebhookSecretEnc      String?

  // Onboarding wizard state for this institution (src/lib/setup.ts). The
  // wizard configures the tenant, so progress lives on the tenant: a second
  // admin of the same bank resumes where the first left off instead of
  // re-entering the bank's telecom + BYOK configuration.
  setupStep                   Int               @default(0)
  setupCompletedAt            DateTime?
  // Sovereign residency: UAE | GCC | MENA | OTHER. Declared by the tenant at
  // onboarding and surfaced on the audit trail, because "where does customer
  // data live" is the first question a PDPL reviewer asks.
  region                      String?
  // The tenant's own Twilio auth token, AES-256-GCM sealed like the vendor
  // webhook secret (write-only: the console learns only whether one exists).
  twilioAuthTokenEnc          String?

  // ── Per-tenant BYOK credentials ────────────────────────────────────────────
  //
  // These live on the ORGANISATION, not on UserProfile, because the tenant is
  // the billing and data-isolation boundary. A bank's fraud team shares one
  // ElevenLabs account and one LLM gateway across every analyst; storing the
  // key per-user would mean N copies of the same secret, N places to rotate it,
  // and no way to revoke it for the whole tenant at once.
  //
  // Resolution order is org-first, user-fallback: an org-level key wins when
  // present, and a user-level key (UserProfile.elevenKeyEnc / llmKeyEnc) is the
  // fallback for a user whose org has not configured one. Both are sealed with
  // the same AES-256-GCM envelope (src/lib/byok.ts) and decrypted only
  // in-process.
  //
  // `llmBaseUrl` is the OpenAI-compatible endpoint for the org's LLM gateway.
  // Null means "use the deployment's own configured endpoint" — the same rule
  // `selectTenantProvider` in src/lib/llm.ts already applies.
  elevenKeyEnc                String?
  llmKeyEnc                   String?
  llmBaseUrl                  String?
  // Institution wallet in intervention credits (1 credit = 1 fired
  // intervention). Consulted whenever the session carries an active
  // organization; the per-user wallet on UserProfile is the org-less
  // fallback. 0 is a real empty wallet, never a missing configuration.
  credits                     Int               @default(0)

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String       @db.Uuid
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

/// An institution's connection to ITS OWN CRM (Zendesk / Salesforce / signed
/// webhook). When a case needs a human, SecureVoice opens a ticket there. The
/// credentials are encrypted at rest (AES-256-GCM, the same envelope as the BYOK
/// key) and never returned by any API: only a masked summary is.
model CrmConnection {
  id         String    @id @default(cuid())
  orgId      String
  provider   String // zendesk | salesforce | webhook
  configEnc  String // AES-GCM(JSON config) - never plaintext
  enabled    Boolean   @default(true)
  lastStatus String? // ok | error
  lastError  String?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orgId, provider])
  @@index([orgId])
}

/// An institution's Agent Workflow — a validated, multi-step, branching
/// journey (src/lib/workflows) an org SAVED from the console builder. The
/// built-in registry stays code (fraud_intervention, specialist_review); this
/// table holds an org's own graphs and their overrides of built-ins, so the
/// builder's Save survives a reload and the runner executes the same validated
/// document the operator designed.
///
/// `orgId` is the tenant namespace and is NEVER nullable in practice: the store
/// normalizes an org-less session to the "default" namespace before writing, so
/// the @@unique([orgId, workflowId]) constraint is what makes a double-save an
/// update rather than a duplicate row (the second analyst pressing Save on the
/// same journey cannot fork it).
model WorkflowDoc {
  id         String   @id @default(cuid())
  /// Tenant namespace ("default" for an org-less session — the same namespace
  /// convention /api/console/audit uses, so a workspace sees its own rows).
  orgId      String
  /// The graph's own `id` (workflow.id), e.g. "fraud_intervention" when
  /// overriding a built-in, or a new id for an institution-authored journey.
  workflowId String
  name       String
  /// The validated Workflow document (schema: workflowSchema).
  graph      Json
  version    String   @default("1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orgId, workflowId])
  @@index([orgId])
}


/// A Paddle customer, mirrored from verified `customer.*` events.
///
/// TENANTED on purpose: `orgId` is OUR organization, not Paddle's, and it is what
/// makes `scopedDb(PaddleCustomer)` work. A Paddle customer with no local org
/// would be an unbuyable orphan — the checkout mints the reference that carries
/// the org, so the mirror always has one.
model PaddleCustomer {
  id         String   @id @default(cuid())
  /// Paddle's customer id (`ctm_...`). Globally UNIQUE: the same customer cannot
  /// be mirrored twice, and a re-sent `customer.created` is an upsert not an insert.
  customerId String   @unique
  /// OUR organization. Every mirror row is scoped to one of ours.
  orgId      String
  email      String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions PaddleSubscription[]

  @@index([orgId])
}

/// A Paddle subscription, mirrored from verified `subscription.*` events.
///
/// `scheduledChangeAction` / `scheduledChangeAt` exist because a SCHEDULED change
/// is not a change: an `active` subscription with a pending cancellation still
/// grants access, and `hasPaidAccess` in src/lib/payments/access.ts is explicit
/// about that. Collapsing the scheduled state into `status` would revoke a paying
/// customer the day they asked to cancel at period end.
model PaddleSubscription {
  id                    String    @id @default(cuid())
  /// Paddle's subscription id (`sub_...`). Globally UNIQUE — the upsert key.
  subscriptionId        String    @unique
  customerId            String
  orgId                 String
  /// `active` | `trialing` | `past_due` | `paused` | `canceled`.
  status                String
  priceId               String
  productId             String
  /// `cancel` | `pause` | null. Present only while a change is SCHEDULED.
  scheduledChangeAction String?
  scheduledChangeAt     DateTime?
  /// End of the current paid period, when Paddle tells us.
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer PaddleCustomer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@index([orgId])
  @@index([customerId])
}

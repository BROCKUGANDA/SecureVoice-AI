// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Inbound pilot / partnership requests submitted from the public site.
/// Minimal personal data by design (PDPL-aware): contact + institution only.
model PilotRequest {
  id          String   @id @default(cuid())
  ref         String   @unique // human-friendly reference, e.g. SV-P-8F3K2
  name        String
  email       String
  institution String
  role        String?
  volume      String? // monthly card volume band, self-reported
  message     String?
  source      String   @default("website") // website | deck | referral
  status      String   @default("new") // new | contacted | qualified | closed
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Idempotency-Key store for upstream API calls (TTS, ASR, agent turns).
/// Persists a (caller, key) â†’ response payload for 24h so a retry is a free
/// replay rather than a second billable call. Concurrent same-key requests
/// dedupe via the unique composite key on (scope, key).
model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String   // "tts" | "asr" | "agent" â€” narrows dedup to the right surface
  key       String   // SHA-256 of the canonical request payload
  callerId  String   // x-caller-id header (or "anon" if absent)
  response  String   // JSON-stringified response (TTS: empty + audio stored elsewhere; ASR/agent: full body)
  statusCode Int     @default(200)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key, callerId])
  @@index([expiresAt])
}

/// Tamper-evident call audit log. Every agent turn + TTS call + ASR call
/// appends one row. chainHash = sha256(prevHash || canonicalRow), so any
/// modification breaks the chain and `verifyChain()` can detect it.
model AuditLog {
  id         String   @id @default(cuid())
  callRef    String   // human reference for the call (e.g. SV-C-8F3K2)
  action     String   // "tts" | "asr" | "agent" | "freeze" | "handoff"
  intent     String?  // agent decision (deny_fraud | confirm_authorized | greeting | unclear)
  callerId   String?  // x-caller-id or "anon"
  redactedText String? // redacted transcript snippet (PII removed)
  meta       String?  // JSON-stringified metadata (lang, voice, latencyMs, etc.)
  prevHash   String?  // chain link
  chainHash  String   @unique
  orgId      String?  // organization scoping (multi-tenant groundwork)
  createdAt  DateTime @default(now())

  @@index([callRef, createdAt])
  @@index([orgId, createdAt])
  @@index([createdAt])
}

/// Registered ElevenLabs voice personas with consent metadata.
/// Cloning endpoints refuse a voice without a recorded consent URL + timestamp.
model Voice {
  id          String   @id @default(cuid())
  voiceId     String   @unique // ElevenLabs voice_id or our internal slug
  language    String   // BCP-47 (en-US, ar-AE, hi-IN, ur-PK, fr-FR, bn-BD)
  displayName String
  isCloned    Boolean  @default(false)
  consentUrl  String?  // required if isCloned=true
  consentAt   DateTime?
  createdAt   DateTime @default(now())
}

/// Platform accounts. Two seeded credentials on every fresh database:
///   operator@securevoice.ae â€” full platform access (Command Center: fire real
///     interventions to their own enrolled phone, inspect audit chains)
///   demo@securevoice.ae â€” demo mode (guided simulation only)
/// Sign-up through the API always creates "demo" role; operator is seed-only.
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("demo") // operator | demo
  passwordHash String   // scrypt$salt$hash (node:crypto)
  createdAt    DateTime @default(now())
}

/// Machine-to-machine producer keys for the headless API. A bank's fraud
/// engine authenticates with `Authorization: Bearer svb_â€¦` instead of HMAC.
/// Only the SHA-256 hash is stored â€” the plaintext key is shown once at creation.
model ProducerKey {
  id         String    @id @default(cuid())
  label      String
  keyHash    String    @unique // sha256 of the plaintext svb_ key
  orgId      String? // tenant scoping for signals fired with this key
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

/// Clerk-backed platform profile + prepaid credits wallet (1 credit = 1
/// intervention signal). The Clerk user is the identity; this row carries the
/// billing state. Roles mirror Clerk publicMetadata.role at first sync:
///   operator â†’ 500 credits Â· demo/analyst â†’ 25 credits
model UserProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  name        String
  role        String   @default("demo") // operator | demo
  orgId       String? // Clerk organization id â€” multi-tenant scoping key
  orgName     String? // white-label: organization display name
  orgLogoUrl  String? // white-label: logo shown in the Command Center
  elevenKeyEnc String? // BYOK ElevenLabs key, AES-256-GCM encrypted at rest
  ttsCharsDate String? // platform-key voice metering day (YYYY-MM-DD)
  ttsCharsToday Int     @default(0) // chars synthesized on the platform key today
  credits     Int      @default(25)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
}

/// Enrolled customer for live delivery (voice/SMS). A bank's signed-up customer
/// who can receive fraud-intervention calls and alerts on their phone.
/// PII discipline: phone is stored for dialing (never logged raw â€” audit rows
/// carry redacted values only), customerRef is the bank's own identifier.
model Customer {
  id              String   @id @default(cuid())
  customerRef     String   @unique // bank's customer identifier (no PII, e.g. CUST-8642)
  phone           String   // E.164 (+9715â€¦), the dial target
  lang            String   @default("en") // en | ar | hi | ur
  channel         String   @default("call") // preferred delivery: call | sms
  consentRecordId String?  // recorded outbound consent (PDPL) â€” required for enroll
  optedOut        Boolean  @default(false) // STOP honoured instantly, no delete (audit trail)
  orgId           String? // organization scoping (multi-tenant groundwork)
  enrolledAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([optedOut])
  @@index([orgId])
}

/// Fraud intervention case â€” the canonical state machine record.
/// One enum, one writer (src/lib/case-state-machine.ts), no exceptions.
model Case {
  id            String   @id @default(cuid())
  caseRef       String   @unique // SV-F-XXXXXX â€” the public case reference
  orgId         String? // tenant scoping
  state         String   @default("RECEIVED") // see case-state-machine.ts
  conversationId String? // ElevenLabs conversation_id â€” join key for post-call webhook
  transactionRef String?
  riskScore      Float?
  language      String   @default("en")
  phone         String? // E.164, redacted in audit
  merchant      String? // sanitised
  amountMinor   Int?
  currency      String?
  consentRecordId String?
  freezeStaged  Boolean  @default(false)
  freezeReference String?
  handoffQueued Boolean  @default(false)
  handoffSpecialist String?
  // Post-call ingest (WP-4): the conversation record becomes billing truth
  // and the bank notification. Transcript is stored redacted only (I-10).
  postCallAt       DateTime?
  postCallEventType String?
  outcome          String? // analysis.call_successful / evaluation verdict
  durationSeconds  Int?   // from the conversation metadata (billing reconcile)
  transcriptRedacted String?
  evaluationResults String? // JSON string of analysis.evaluation_criteria_results
  dataCollectionResults String? // JSON string of analysis.data_collection_results
  // Crypto-shredding (WP-15). Erasure destroys the data key, which makes every
  // encrypted payload undecryptable while the audit chain â€” which stores only
  // hashes â€” still verifies from genesis. That is how right-to-erasure
  // coexists with an immutable log.
  dataKeyEnc         String?
  erasedAt           DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId, state])
  @@index([orgId, createdAt])
  @@index([conversationId])
}

/// One row per inbound ElevenLabs delivery (verified signature) â€” the
/// processing registry and the dedupe record. Unique per
/// (provider, eventType, conversationId, eventTimestamp): an exact redelivery
/// is a replay and creates nothing new. Not processed rows may be retried.
model WebhookEvent {
  id             String   @id @default(cuid())
  provider       String   @default("elevenlabs")
  eventType      String
  conversationId String?
  agentId        String?
  eventTimestamp Int?
  processed      Boolean  @default(false)
  error          String?
  processedAt    DateTime?
  receivedAt     DateTime @default(now())

  @@unique([provider, eventType, conversationId, eventTimestamp])
  @@index([processed])
  @@index([conversationId])
}

/// Inbound webhooks that could not be correlated to a case land here â€” never
/// silently dropped (WP-4 step 4). Redacted transcript excerpt only.
model WebhookQuarantine {
  id            String   @id @default(cuid())
  eventType     String
  conversationId String?
  reason        String
  transcriptRedacted String?
  eventTimestamp Int?
  createdAt     DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

/// Transactional outbox (WP-5). The case transition and this row commit in
/// the SAME transaction, so a verdict can never exist without its delivery.
/// PENDING -> SENDING -> DELIVERED, or -> DEAD after the retry ladder
/// exhausts (then a DeadLetter row exists for manual replay).
model OutboxEvent {
  id            String   @id @default(cuid()) // also the event_id the bank deduplicates on
  orgId         String?
  caseRef       String?
  eventType     String   // e.g. case.notified
  payload       String   // canonical JSON body actually signed and sent
  targetUrl     String
  state         String   @default("PENDING") // PENDING | SENDING | DELIVERED | DEAD
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([state, nextAttemptAt])
  @@index([caseRef])
}

/// Dead-letter table: deliveries that exhausted the retry ladder.
/// Manual replay (admin-only endpoint) re-queues the matching OutboxEvent.
model DeadLetter {
  id        String   @id @default(cuid())
  eventId   String   @unique // OutboxEvent.id
  eventType String
  caseRef   String?
  payload   String
  targetUrl String
  error     String
  attempts  Int
  replayedAt DateTime?
  failedAt  DateTime @default(now())

  @@index([failedAt])
}

/// Deliveries received by the in-app receiver (the /inspector demo surface,
/// and the fixture a bank integration team can point its own tests at).
model InboundBankEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  eventType       String
  caseRef         String?
  signatureValid  Boolean
  signatureHeader String?
  body            String
  receivedAt      DateTime @default(now())

  @@index([receivedAt])
}

/// In-app notification inbox (WP-20). One row per (org, alert type, window) so
/// a burst that would otherwise page a human 500 times arrives as ONE alert
/// with a count. Escalation advances through the contact ladder until a human
/// acknowledges it â€” an unacknowledged page is a real capability gap, not a
/// UI detail.
model Notification {
  id             String    @id @default(cuid())
  orgId          String?
  caseRef        String?
  alertType      String    // fraud_confirmed | escalation | case_stuck | billing_anomaly
  severity       String    @default("info") // page | urgent | info
  title          String
  body           String?
  dedupeKey      String    @unique // {orgId}:{alertType}:{windowBucket}
  windowMinutes  Int       @default(0)
  count          Int       @default(1)
  contactIndex   Int       @default(0)
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  acknowledgedAt DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId, acknowledgedAt])
  @@index([alertType])
}

/// Append-only usage ledger (WP-13). There is NO mutable credits column: the
/// balance is the sum of these rows, which is what makes it auditable and race
/// free. All amounts are INTEGER minor units â€” never floats.
model UsageLedger {
  id          String   @id @default(cuid())
  orgId       String?
  caseRef     String?
  attemptNo   Int      @default(1)
  kind        String   // reserve | consume | release | topup | refund
  units       Int      // signed by kind: reserve/consume/topup positive, release/refund negative
  reason      String?
  /// Idempotency key: {caseRef}:{attemptNo}:{kind}. The unique index is the
  /// guarantee against double-charging on a retried webhook, not the retry logic.
  idemKey     String   @unique
  balanceAfter Int?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([caseRef])
}

/// A settled or pending payment (WP-13). Written by a PaymentProvider adapter
/// only â€” no domain code touches a gateway type.
model PaymentRecord {
  id           String   @id @default(cuid())
  orgId        String?
  provider     String   // manualinvoice | paystack | flutterwave | paddle
  reference    String   @unique // our reference, generated by us (idempotency key)
  amountMinor  Int
  currency     String
  status       String   @default("pending") // pending | success | failed | refunded
  entitlementsJson String?
  verifiedAt   DateTime?
  verifiedBy   String?  // operator who confirmed a manual invoice (dual control)
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
